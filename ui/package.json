{
  "name": "ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.20.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write src e2e scripts *.ts *.js",
    "e2e": "playwright test",
    "metrics": "node scripts/arch-metrics.mjs",
    "ux:capture": "node scripts/ux-capture.mjs",
    "preflight": "npm run check && npm run lint && npm run format && npm run metrics -- --check ../docs/stabilization/ui/baseline.json && npm run build && npm run test && npm run e2e",
    "gen:api": "openapi-typescript src/lib/generated/openapi.json -o src/lib/generated/api-schema.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.9",
    "@types/node": "^24.13.3",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@lucide/svelte": "^1.77.0",
    "bits-ui": "^2.22.0",
    "monaco-editor": "^0.57.0",
    "svelte-sonner": "^1.2.3"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "^3.4.17"
    },
    "openapi-typescript": {
      "typescript": "$typescript"
    },
    "eslint": {
      "minimatch": "^11.0.3"
    },
    "@eslint/config-array": {
      "minimatch": "^11.0.3"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.3"
    }
  }
}
