{
  "id": "Probe1528HeldShot",
  "description": "#1561 (feature #1528, stage A), probe P4: the music-video path for one shot - 'slice_audio' cuts the song at 'start_frame' for 'num_frames', and one Ref2VA turbo shot takes the performer's portrait plus that slice as an audio reference and holds it ('hold_audio': 'previous_result:slice'), exactly as templates/minimax/music-video's 'shot' step does, at the same settings (960x544, 124 frames, 9 steps, int4). The performer is not the singer, so the probe asks whether a non-singer in frame mouths the held vocal.",
  "variables": {
    "prompt": "",
    "performer": "asset:qa-cast/hal-portrait.jpg",
    "song": "asset:song/la-vela.mp3",
    "start_frame": 0,
    "sample_rate": 44100,
    "seed": 1001,
    "num_inference_steps": 9,
    "video_shift": 12.0,
    "audio_shift": 3.0,
    "lora_scale": 1.0,
    "lora_alpha": null,
    "lora_model_name": "lightx2v/Minimax-h3-Turbo",
    "lora_weight_name": "minimax_h3_ref2v_turbo_8step_v1.0_768p_bf16.safetensors",
    "lora_adapter_name": "turbo",
    "weights_dtype": "{int4}",
    "attention_backend": "sparse",
    "sparse_tau": 0.5,
    "sparse_topk": 0.15,
    "cache": null,
    "width": 960,
    "height": 544,
    "num_frames": 124
  },
  "cost": [
    {
      "device": "cuda",
      "name": "RTX 3090",
      "vram_gb": 24,
      "minutes": 7.88,
      "guide_factor": 2.0,
      "video_reference_exponent": 2.0
    }
  ],
  "vram_estimate": {
    "base_gb": 16.0,
    "bytes_per_voxel": 28.71,
    "gb_per_reference": 1.0,
    "bytes_per_reference_voxel": 40,
    "voxel_variables": [
      "width",
      "height",
      "num_frames"
    ],
    "reason": "Ref2VA holds every reference's encoding resident beside the video latents, so the ceiling is a fixed base, a per-voxel term for the VAE decode's conv3d activation (width * height * num_frames), and a per-reference term. Classified against the 24 GB entry from the #479 field report (lem, RTX 3090 24 GB, int4 + 768p turbo LoRA, 9 steps, 2026-09-25/26) at 1344x768: 175 frames x 2 refs, 209 x 2 and 175 x 3 ran (projected 22.83, 23.77 and 23.83 GB); 209 x 3 OOM'd in reference encode needing a further 5.1 GB and 260 x 1 OOM'd at denoise step 1 needing a further 4.8 GB (projected 24.77 and 24.18 GB). The refused allocations are lower bounds, not peaks, so this is a classification with about 0.2 GB of margin either side, not a fitted curve. bytes_per_voxel is unchanged from #324's calibration (job 282172105da1); base_gb drops 0.3 GB now the references are counted separately. bytes_per_reference_voxel (#1429) is for a video reference, which is encoded on the target canvas and charged its frames x canvas: #1401 ran a whole 124-frame reference at 1344x768 (job e6ecb7df55ec) to an OOM that the base projection (about 21.4 GB) did not see, and the same reference at 960x544 and a 22-frame trim_video window at 1344x768 ran. 40 bytes sits inside the 22 to 71 bytes that separates the arms (it flags the first, passes the other two); a clip whose length is not known before the run is not charged"
  },
  "variable_constraints": {
    "num_frames": {
      "modulus": 17,
      "remainder": 5,
      "min_frames": 124,
      "max_frames": 345,
      "snap": "up",
      "reason": "the video VAE encodes 17 * n + 5 frames, and MiniMax-H3 generates between 5 and 15 seconds at 24 fps"
    },
    "width": {
      "modulus": 32,
      "remainder": 0,
      "reason": "MiniMax-H3's pipeline refuses a `width` or `height` that is not a multiple of 32, and only after the weights have loaded; refused here instead, with no 'snap', since rounding would be a silent change to the size asked for"
    },
    "height": {
      "modulus": 32,
      "remainder": 0,
      "reason": "MiniMax-H3's pipeline refuses a `width` or `height` that is not a multiple of 32, and only after the weights have loaded; refused here instead, with no 'snap', since rounding would be a silent change to the size asked for"
    }
  },
  "seed": "variable:seed",
  "steps": [
    {
      "name": "slice",
      "task": {
        "command": "slice_audio",
        "arguments": {
          "audio": "variable:song",
          "sample_rate": "variable:sample_rate",
          "start_frame": "variable:start_frame",
          "lead_frames": 0,
          "num_frames": "variable:num_frames",
          "fps": 24
        }
      }
    },
    {
      "name": "shot",
      "pipeline": {
        "configuration": {
          "component_type": "ModularPipeline",
          "pre_load_modules": [
            "sdnq"
          ],
          "load_components": {
            "dtype": "torch.bfloat16",
            "quantization_config": {
              "transformer_ref": {
                "configuration": {
                  "config_type": "sdnq.SDNQConfig"
                },
                "arguments": {
                  "weights_dtype": "variable:weights_dtype",
                  "quantization_device": "cuda",
                  "return_device": "cpu",
                  "use_quantized_matmul": true,
                  "dequantize_fp32": false,
                  "modules_to_not_convert": [
                    "proj_in",
                    "audio_proj_in",
                    "context_embedder",
                    "time_embedder",
                    "time_proj",
                    "token_refiner",
                    "norm_out",
                    "proj_out",
                    "audio_proj_out"
                  ]
                }
              },
              "text_encoder": {
                "configuration": {
                  "config_type": "sdnq.SDNQConfig"
                },
                "arguments": {
                  "weights_dtype": "variable:weights_dtype",
                  "quantization_device": "cuda",
                  "return_device": "cpu",
                  "dequantize_fp32": false,
                  "modules_to_not_convert": [
                    ".model.visual",
                    "lm_head"
                  ]
                }
              },
              "vae": {
                "configuration": {
                  "config_type": "sdnq.SDNQConfig"
                },
                "arguments": {
                  "weights_dtype": "{int8}",
                  "quant_conv": true,
                  "use_quantized_matmul_conv": true,
                  "quantization_device": "cuda",
                  "return_device": "cpu",
                  "dequantize_fp32": false
                }
              }
            }
          },
          "components": {
            "transformer_ref": {
              "attention_backend": "variable:attention_backend",
              "sparse_tau": "variable:sparse_tau",
              "sparse_topk": "variable:sparse_topk",
              "group_offload": {
                "offload_type": "block_level",
                "num_blocks_per_group": 1,
                "use_stream": true,
                "record_stream": true,
                "low_cpu_mem_usage": true
              }
            },
            "text_encoder": {
              "remove_modules": [
                "lm_head"
              ]
            },
            "text_encoder.model": {
              "truncate_layers": {
                "language_model.layers": 51
              },
              "group_offload": {
                "offload_type": "leaf_level"
              }
            },
            "vae": {
              "device": "cuda",
              "residency": "on_demand"
            },
            "audio_vae": {
              "device": "cuda",
              "residency": "on_demand"
            }
          },
          "cache": "variable:cache"
        },
        "from_pretrained_arguments": {
          "model_name": "MiniMaxAI/MiniMax-H3",
          "workflow": "ref2va"
        },
        "loras": [
          {
            "model_name": "variable:lora_model_name",
            "weight_name": "variable:lora_weight_name",
            "adapter_name": "variable:lora_adapter_name",
            "scale": "variable:lora_scale",
            "alpha": "variable:lora_alpha"
          }
        ],
        "scheduler": {
          "shift": "variable:video_shift"
        },
        "audio_scheduler": {
          "shift": "variable:audio_shift"
        },
        "arguments": {
          "prompt": "variable:prompt",
          "references": [
            {
              "reference_type": "diffusers.modular_pipelines.minimax_h3.MiniMaxH3ImageReference",
              "from_file": "variable:performer"
            },
            {
              "reference_type": "diffusers.modular_pipelines.minimax_h3.MiniMaxH3AudioReference",
              "from_previous_result": "slice",
              "sample_rate": "variable:sample_rate"
            }
          ],
          "hold_audio": "previous_result:slice",
          "num_frames": "variable:num_frames",
          "width": "variable:width",
          "height": "variable:height",
          "num_inference_steps": "variable:num_inference_steps",
          "output": [
            "videos",
            "audio",
            "sampling_rate"
          ]
        }
      },
      "result": {
        "content_type": "video/mp4",
        "fps": 24,
        "subfolder": "final"
      }
    }
  ]
}
