{
  "id": "BenchS1Static",
  "description": "Long-form bench S1 (static): the #1175 control (arm A), reproduced exactly - same workflow, prompt, still, seed 1166 and arguments as probe-1166's drift-chain. #1175 drift probe: templates/minimax/chained-segments as shipped (turbo-4step-keyframe, fl2va) with guide continuity, plus two probe variables: `anchor` (chain.anchor, arm C) and `guide_noise` (H3 call argument, arm B; null is dropped before the call, so the default is today's call). Defaults are the control (arm A). Counter-round knobs (all null/off by default, so the defaults are still the control): anchor_strength, guide_backoff, keystone, look_hold (chain keys) and antiburn_model_name (set to minimax-h3's Imagineer13/H3-Anti-Burn-LoRA to load it at antiburn_scale on every segment). `duration_seconds` (null by default, so the chain keeps `segments`) asks for a length in seconds instead, for the two-minute confirmations. Task 13/14 knobs (off by default, so the defaults are still the control): `check` and `retries` (the per-segment check and its re-roll budget, chain keys) and `keep_segments` (save_segments + keep_segments, the segment files repair-segment needs). `latent_carry` (null by default) is the experimental latent carry (#1150, chain key experimental_latent_carry; needs DW_EXPERIMENTAL_REFINE_WINDOWS=1 on the server): each guide takes the previous segment's own tail latents instead of re-encoding its decoded frames. `tst` (null by default) is the experimental TST temporal-attention correction (#1196, H3 call argument experimental_tst {tau, per_head}; needs DW_EXPERIMENTAL_REFINE_WINDOWS=1 and attention_backend null - it runs on dense attention).",
  "variables": {
    "prompt": "For the target video, at 0.00 seconds into the target video, <Picture 1> (from [Shot 1]) is fully referenced.\n\nintegrated_multimodal_description: [Shot 1] Cinematic, live-action, one continuous static shot. The shot opens exactly on <Picture 1>: a young woman in a plain dark grey sweater stands centered in front of a flat painted wall of bold diagonal rainbow stripes with a black circle at upper left and a teal square at lower right. She breathes calmly, blinks, shifts her weight slightly and turns her head a little left and right, staying in place at the center of the frame. The painted wall stays exactly as it is, evenly lit by soft studio light. The camera is locked off on a tripod and never moves.\n\noverall_soundscape: Quiet studio room tone, the soft rustle of a wool sweater, calm breathing.\n\nnon_diegetic_music: None.",
    "image": "asset:bench/static-stripes.jpg",
    "num_frames": 124,
    "segments": 10,
    "continuity": "guide",
    "guide_frames": 22,
    "width": 960,
    "height": 544,
    "num_inference_steps": 5,
    "video_shift": 6,
    "audio_shift": 3,
    "weights_dtype": "{int4}",
    "seed": 1166,
    "anchor": "none",
    "guide_noise": null,
    "lora_model_name": "lightx2v/Minimax-h3-Turbo",
    "lora_weight_name": "minimax_h3_fl2v_turbo_4step_v1.2_768p_bf16.safetensors",
    "attention_backend": "sparse",
    "anchor_strength": null,
    "guide_backoff": null,
    "keystone": null,
    "look_hold": null,
    "antiburn_model_name": null,
    "antiburn_weight_name": "h3_antiburn_universal_v1.safetensors",
    "antiburn_scale": 0.6,
    "duration_seconds": null,
    "check": false,
    "retries": 0,
    "keep_segments": false,
    "latent_carry": null,
    "tst": null
  },
  "variable_constraints": {
    "num_frames": {
      "modulus": 17,
      "remainder": 5,
      "min_frames": 124,
      "max_frames": 345,
      "snap": "up",
      "reason": "the video VAE encodes 17 * n + 5 frames, and MiniMax-H3 generates between 5 and 15 seconds at 24 fps"
    },
    "width": {
      "modulus": 32,
      "remainder": 0,
      "reason": "H3 refuses width/height not a multiple of 32"
    },
    "height": {
      "modulus": 32,
      "remainder": 0,
      "reason": "H3 refuses width/height not a multiple of 32"
    }
  },
  "seed": "variable:seed",
  "steps": [
    {
      "name": "chained_keyframe_to_video_audio",
      "pipeline": {
        "configuration": {
          "component_type": "ModularPipeline",
          "pre_load_modules": [
            "sdnq"
          ],
          "load_components": {
            "dtype": "torch.bfloat16",
            "quantization_config": {
              "transformer": {
                "configuration": {
                  "config_type": "sdnq.SDNQConfig"
                },
                "arguments": {
                  "weights_dtype": "variable:weights_dtype",
                  "quantization_device": "cuda",
                  "return_device": "cpu",
                  "use_quantized_matmul": true,
                  "dequantize_fp32": false,
                  "modules_to_not_convert": [
                    "proj_in",
                    "audio_proj_in",
                    "context_embedder",
                    "time_embedder",
                    "time_proj",
                    "token_refiner",
                    "norm_out",
                    "proj_out",
                    "audio_proj_out"
                  ]
                }
              },
              "text_encoder": {
                "configuration": {
                  "config_type": "sdnq.SDNQConfig"
                },
                "arguments": {
                  "weights_dtype": "variable:weights_dtype",
                  "quantization_device": "cuda",
                  "return_device": "cpu",
                  "dequantize_fp32": false,
                  "modules_to_not_convert": [
                    ".model.visual",
                    "lm_head"
                  ]
                }
              },
              "vae": {
                "configuration": {
                  "config_type": "sdnq.SDNQConfig"
                },
                "arguments": {
                  "weights_dtype": "{int8}",
                  "quant_conv": true,
                  "use_quantized_matmul_conv": true,
                  "quantization_device": "cuda",
                  "return_device": "cpu",
                  "dequantize_fp32": false
                }
              }
            }
          },
          "components": {
            "transformer": {
              "attention_backend": "variable:attention_backend",
              "sparse_tau": 0.5,
              "sparse_topk": 0.15,
              "group_offload": {
                "offload_type": "block_level",
                "num_blocks_per_group": 2,
                "use_stream": true,
                "record_stream": true,
                "low_cpu_mem_usage": true
              }
            },
            "text_encoder": {
              "remove_modules": [
                "lm_head"
              ]
            },
            "text_encoder.model": {
              "truncate_layers": {
                "language_model.layers": 51
              },
              "group_offload": {
                "offload_type": "leaf_level"
              }
            },
            "vae": {
              "device": "cuda",
              "residency": "on_demand"
            },
            "audio_vae": {
              "device": "cuda",
              "residency": "on_demand"
            }
          }
        },
        "from_pretrained_arguments": {
          "model_name": "MiniMaxAI/MiniMax-H3",
          "workflow": "fl2va"
        },
        "loras": [
          {
            "model_name": "variable:lora_model_name",
            "weight_name": "variable:lora_weight_name",
            "adapter_name": "turbo",
            "scale": 1
          },
          {
            "model_name": "variable:antiburn_model_name",
            "weight_name": "variable:antiburn_weight_name",
            "adapter_name": "antiburn",
            "scale": "variable:antiburn_scale"
          }
        ],
        "chain": {
          "segments": "variable:segments",
          "duration_seconds": "variable:duration_seconds",
          "continuity": "variable:continuity",
          "guide_frames": "variable:guide_frames",
          "anchor": "variable:anchor",
          "segment_argument": "image",
          "trim_frames": 2,
          "crossfade_ms": 80,
          "fps": 24,
          "frame_snap": "constraint:num_frames",
          "anchor_strength": "variable:anchor_strength",
          "guide_backoff": "variable:guide_backoff",
          "keystone": "variable:keystone",
          "look_hold": "variable:look_hold",
          "check": "variable:check",
          "retries": "variable:retries",
          "save_segments": "variable:keep_segments",
          "keep_segments": "variable:keep_segments",
          "experimental_latent_carry": "variable:latent_carry"
        },
        "scheduler": {
          "shift": "variable:video_shift"
        },
        "audio_scheduler": {
          "shift": "variable:audio_shift"
        },
        "arguments": {
          "prompt": "variable:prompt",
          "image": "variable:image",
          "num_frames": "variable:num_frames",
          "width": "variable:width",
          "height": "variable:height",
          "num_inference_steps": "variable:num_inference_steps",
          "guide_noise": "variable:guide_noise",
          "experimental_tst": "variable:tst",
          "output": [
            "videos",
            "audio",
            "sampling_rate"
          ]
        }
      },
      "result": {
        "content_type": "video/mp4",
        "fps": 24,
        "subfolder": "final"
      }
    }
  ]
}
