{
  "id": "VisualMemoryWindow",
  "summary": "#1401 probe: H3 ref2va shot, portrait + trimmed window",
  "description": "Feature #1398 stage A (#1401), the visual-memory cut probe. A trim_video step keeps num_window frames of window_source (an output: of an earlier run) from start_frame; the MiniMax-H3 ref2va shot (turbo LoRA, 124 frames, 1344x768) then takes the cast portrait subject plus that window as a MiniMaxH3VideoReference with its soundtrack dropped. Arms B2 and S2.",
  "seed": "variable:seed",
  "cost_drivers": [
    "num_frames",
    "num_inference_steps",
    "width",
    "height",
    "weights_dtype",
    "lora_model_name",
    "attention_backend",
    "cache"
  ],
  "variables": {
    "prompt": "",
    "subject": "asset:cast/estela.jpg",
    "num_frames": 124,
    "width": 1344,
    "height": 768,
    "num_inference_steps": 9,
    "video_shift": 12.0,
    "audio_shift": 3.0,
    "lora_scale": 1.0,
    "lora_alpha": null,
    "lora_model_name": "lightx2v/Minimax-h3-Turbo",
    "lora_weight_name": "minimax_h3_ref2v_turbo_8step_v1.0_768p_bf16.safetensors",
    "lora_adapter_name": "turbo",
    "weights_dtype": "{int4}",
    "seed": 1398,
    "attention_backend": "sparse",
    "sparse_tau": 0.5,
    "sparse_topk": 0.15,
    "cache": null,
    "window_source": null,
    "start_frame": 0,
    "num_window": 5
  },
  "variable_constraints": {
    "num_frames": {
      "modulus": 17,
      "remainder": 5,
      "min_frames": 124,
      "max_frames": 345,
      "snap": "up",
      "reason": "the video VAE encodes 17 * n + 5 frames, and MiniMax-H3 generates between 5 and 15 seconds at 24 fps"
    },
    "width": {
      "modulus": 32,
      "remainder": 0,
      "reason": "MiniMax-H3's pipeline refuses a `width` or `height` that is not a multiple of 32"
    },
    "height": {
      "modulus": 32,
      "remainder": 0,
      "reason": "MiniMax-H3's pipeline refuses a `width` or `height` that is not a multiple of 32"
    }
  },
  "steps": [
    {
      "name": "window",
      "task": {
        "command": "trim_video",
        "arguments": {
          "video": "variable:window_source",
          "start_frame": "variable:start_frame",
          "num_frames": "variable:num_window"
        }
      },
      "result": {
        "content_type": "video/mp4",
        "fps": 24,
        "subfolder": "intermediate"
      }
    },
    {
      "name": "shot",
      "pipeline": {
        "configuration": {
          "component_type": "ModularPipeline",
          "pre_load_modules": [
            "sdnq"
          ],
          "load_components": {
            "dtype": "torch.bfloat16",
            "quantization_config": {
              "transformer_ref": {
                "configuration": {
                  "config_type": "sdnq.SDNQConfig"
                },
                "arguments": {
                  "weights_dtype": "variable:weights_dtype",
                  "quantization_device": "cuda",
                  "return_device": "cpu",
                  "use_quantized_matmul": true,
                  "dequantize_fp32": false,
                  "modules_to_not_convert": [
                    "proj_in",
                    "audio_proj_in",
                    "context_embedder",
                    "time_embedder",
                    "time_proj",
                    "token_refiner",
                    "norm_out",
                    "proj_out",
                    "audio_proj_out"
                  ]
                }
              },
              "text_encoder": {
                "configuration": {
                  "config_type": "sdnq.SDNQConfig"
                },
                "arguments": {
                  "weights_dtype": "variable:weights_dtype",
                  "quantization_device": "cuda",
                  "return_device": "cpu",
                  "dequantize_fp32": false,
                  "modules_to_not_convert": [
                    ".model.visual",
                    "lm_head"
                  ]
                }
              },
              "vae": {
                "configuration": {
                  "config_type": "sdnq.SDNQConfig"
                },
                "arguments": {
                  "weights_dtype": "{int8}",
                  "quant_conv": true,
                  "use_quantized_matmul_conv": true,
                  "quantization_device": "cuda",
                  "return_device": "cpu",
                  "dequantize_fp32": false
                }
              }
            }
          },
          "components": {
            "transformer_ref": {
              "attention_backend": "variable:attention_backend",
              "sparse_tau": "variable:sparse_tau",
              "sparse_topk": "variable:sparse_topk",
              "group_offload": {
                "offload_type": "block_level",
                "num_blocks_per_group": 1,
                "use_stream": true,
                "record_stream": true,
                "low_cpu_mem_usage": true
              }
            },
            "text_encoder": {
              "remove_modules": [
                "lm_head"
              ]
            },
            "text_encoder.model": {
              "truncate_layers": {
                "language_model.layers": 51
              },
              "group_offload": {
                "offload_type": "leaf_level"
              }
            },
            "vae": {
              "device": "cuda",
              "residency": "on_demand"
            },
            "audio_vae": {
              "device": "cuda",
              "residency": "on_demand"
            }
          },
          "cache": "variable:cache"
        },
        "from_pretrained_arguments": {
          "model_name": "MiniMaxAI/MiniMax-H3",
          "workflow": "ref2va"
        },
        "loras": [
          {
            "model_name": "variable:lora_model_name",
            "weight_name": "variable:lora_weight_name",
            "adapter_name": "variable:lora_adapter_name",
            "scale": "variable:lora_scale",
            "alpha": "variable:lora_alpha"
          }
        ],
        "scheduler": {
          "shift": "variable:video_shift"
        },
        "audio_scheduler": {
          "shift": "variable:audio_shift"
        },
        "arguments": {
          "prompt": "variable:prompt",
          "references": [
            {
              "reference_type": "diffusers.modular_pipelines.minimax_h3.MiniMaxH3ImageReference",
              "from_file": "variable:subject"
            },
            {
              "reference_type": "diffusers.modular_pipelines.minimax_h3.MiniMaxH3VideoReference",
              "from_previous_result": "window",
              "audio": null
            }
          ],
          "num_frames": "variable:num_frames",
          "width": "variable:width",
          "height": "variable:height",
          "num_inference_steps": "variable:num_inference_steps",
          "output": [
            "videos",
            "audio",
            "sampling_rate"
          ]
        }
      },
      "result": {
        "content_type": "video/mp4",
        "fps": 24,
        "subfolder": "final"
      }
    }
  ]
}