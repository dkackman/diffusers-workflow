{
    "variables": {
        "prompt": "an evil version of this image",
        "image": {
            "location": "https://raw.githubusercontent.com/Hadamcik/sage-permission-probe/3e0f80d1fbed7ea0ad118be1771436b8dda59bba/public/icon.png"
        },
        "num_images_per_prompt": 1,
        "num_inference_steps": 15,
        "guidance_scale": 2.0,
        "strength": 0.75,
        "width": 96,
        "height": 96
    },
    "id": "FluxImg2Img",
    "steps": [
        {
            "name": "main",
            "pipeline": {
                "configuration": {
                    "component_type": "FluxImg2ImgPipeline",
                    "offload": "sequential"
                },
                "from_pretrained_arguments": {
                    "model_name": "black-forest-labs/FLUX.1-dev",
                    "torch_dtype": "torch.bfloat16"
                },
                "arguments": {
                    "prompt": "variable:prompt",
                    "image": "variable:image",
                    "num_images_per_prompt": "variable:num_images_per_prompt",
                    "guidance_scale": "variable:guidance_scale",
                    "strength": "variable:strength",
                    "num_inference_steps": "variable:num_inference_steps",
                    "max_sequence_length": 512
                }
            },
            "result": {
                "content_type": "image/jpeg"
            }
        }
    ]
}