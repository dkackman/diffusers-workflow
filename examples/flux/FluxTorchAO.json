{
    "variables": {
        "prompt": "a marmot wearing a tophat, in a forest scene."
    },
    "id": "FluxTorchAO",
    "steps": [
        {
            "name": "main",
            "pipeline": {
                "configuration": {
                    "component_type": "FluxPipeline",
                    "components": {
                        "transformer": {
                            "compile": {
                                "repeated_blocks": true,
                                "fullgraph": true
                            }
                        }
                    }
                },
                "transformer": {
                    "configuration": {
                        "component_type": "FluxTransformer2DModel"
                    },
                    "quantization_config": {
                        "configuration": {
                            "config_type": "TorchAoConfig"
                        },
                        "arguments": {
                            "quant_type": "torchao.quantization.Int4WeightOnlyConfig"
                        }
                    },
                    "from_pretrained_arguments": {
                        "model_name": "black-forest-labs/Flux.1-Dev",
                        "subfolder": "transformer",
                        "torch_dtype": "torch.bfloat16"
                    }
                },
                "from_pretrained_arguments": {
                    "model_name": "black-forest-labs/FLUX.1-dev",
                    "torch_dtype": "torch.bfloat16"
                },
                "arguments": {
                    "prompt": "variable:prompt"
                }
            },
            "result": {
                "content_type": "image/jpeg",
                "embed_metadata": true
            }
        }
    ]
}