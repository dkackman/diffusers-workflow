{
    "id": "MiniMaxH3I2VEnhancePrompt",
    "description": "Showing the enhancer the same picture the pipeline gets. An image-conditioned run pins the first frame, so a prompt written blind will describe a scene the keyframe contradicts and the two conditionings fight each other. Passing the image into the enhancer as well makes it a vision-language model that writes from what is actually in the picture - subject, setting, lighting and style - and the pipeline then receives a prompt that agrees with its own starting frame. The enhancer is released before the generation model loads, so the two never hold device memory at once.",
    "variables": {
        "idea": "Task: I2VA. Duration: 5.17 seconds. Idea: a blown glass figure's tentacles writhe as it speaks in a deep, echoing voice, calling forth ancient ancestors.",
        "enhancer_model_name": "Qwen/Qwen3-VL-4B-Instruct",
        "enhancer_device": "cuda",
        "image": {
            "location": "https://pbs.twimg.com/profile_images/1961215773080211456/nILQt5Fv_400x400.jpg"
        },
        "num_frames": 124,
        "width": 960,
        "height": 544,
        "num_inference_steps": 9,
        "weights_dtype": "{int4}",
        "lora_scale": 1.0,
        "lora_model_name": "lightx2v/Minimax-h3-Turbo",
        "lora_weight_name": "minimax_h3_fl2v_turbo_8step_v1.0_bf16.safetensors",
        "lora_adapter_name": "turbo"
    },
    "steps": [
        {
            "name": "prompt_enhancer",
            "release_models": true,
            "workflow": {
                "path": "builtin:h3_context_ir.json",
                "arguments": {
                    "prompt": "variable:idea",
                    "image": "variable:image",
                    "device": "variable:enhancer_device",
                    "model_name": "variable:enhancer_model_name"
                }
            },
            "result": {
                "content_type": "text/plain"
            }
        },
        {
            "name": "keyframe_to_video_audio",
            "pipeline": {
                "configuration": {
                    "component_type": "ModularPipeline",
                    "pre_load_modules": [
                        "sdnq"
                    ],
                    "cache": {
                        "type": "first_block",
                        "threshold": 0.1
                    },
                    "load_components": {
                        "dtype": "torch.bfloat16",
                        "quantization_config": {
                            "transformer": {
                                "configuration": {
                                    "config_type": "sdnq.SDNQConfig"
                                },
                                "arguments": {
                                    "weights_dtype": "variable:weights_dtype",
                                    "quantization_device": "cuda",
                                    "return_device": "cpu",
                                    "use_quantized_matmul": true,
                                    "dequantize_fp32": false,
                                    "modules_to_not_convert": [
                                        "proj_in",
                                        "audio_proj_in",
                                        "context_embedder",
                                        "time_embedder",
                                        "time_proj",
                                        "token_refiner",
                                        "norm_out",
                                        "proj_out",
                                        "audio_proj_out"
                                    ]
                                }
                            },
                            "text_encoder": {
                                "configuration": {
                                    "config_type": "sdnq.SDNQConfig"
                                },
                                "arguments": {
                                    "weights_dtype": "variable:weights_dtype",
                                    "quantization_device": "cuda",
                                    "return_device": "cpu",
                                    "dequantize_fp32": false,
                                    "modules_to_not_convert": [
                                        ".model.visual",
                                        "lm_head"
                                    ]
                                }
                            },
                            "vae": {
                                "configuration": {
                                    "config_type": "sdnq.SDNQConfig"
                                },
                                "arguments": {
                                    "weights_dtype": "{int8}",
                                    "quant_conv": true,
                                    "use_quantized_matmul_conv": true,
                                    "quantization_device": "cuda",
                                    "return_device": "cpu",
                                    "dequantize_fp32": false
                                }
                            }
                        }
                    },
                    "components": {
                        "transformer": {
                            "group_offload": {
                                "offload_type": "block_level",
                                "num_blocks_per_group": 5,
                                "use_stream": true,
                                "record_stream": true,
                                "low_cpu_mem_usage": true
                            }
                        },
                        "text_encoder.model": {
                            "group_offload": {
                                "offload_type": "leaf_level"
                            }
                        },
                        "vae": {
                            "device": "cuda"
                        },
                        "audio_vae": {
                            "device": "cuda"
                        }
                    },
                    "vae": {
                        "enable_tiling": true
                    }
                },
                "from_pretrained_arguments": {
                    "model_name": "MiniMaxAI/MiniMax-H3",
                    "workflow": "fl2va"
                },
                "loras": [
                    {
                        "model_name": "variable:lora_model_name",
                        "weight_name": "variable:lora_weight_name",
                        "adapter_name": "variable:lora_adapter_name",
                        "scale": "variable:lora_scale"
                    }
                ],
                "arguments": {
                    "prompt": "previous_result:prompt_enhancer",
                    "image": "variable:image",
                    "num_frames": "variable:num_frames",
                    "width": "variable:width",
                    "height": "variable:height",
                    "num_inference_steps": "variable:num_inference_steps",
                    "output": [
                        "videos",
                        "audio",
                        "sampling_rate"
                    ]
                }
            },
            "result": {
                "content_type": "video/mp4",
                "fps": 24
            }
        }
    ]
}