{
    "variables": {
        "prompt": "make the woman blonde",
        "input_image": "https://pbs.twimg.com/media/HNi-N_eWIAAJfTZ?format=jpg&name=900x900"
    },
    "id": "Krea2Edit",
    "steps": [
        {
            "name": "txt2img",
            "pipeline": {
                "configuration": {
                    "component_type": "DiffusionPipeline",
                    "offload": "sequential"
                },
                "from_pretrained_arguments": {
                    "model_name": "krea/Krea-2-Turbo",
                    "torch_dtype": "torch.bfloat16",
                    "custom_pipeline": "ostris/Krea2OstrisEdit",
                    "trust_remote_code": true
                },
                "loras": [
                    {
                        "model_name": "ostris/krea2_turbo_style_reference",
                        "weight_name": "krea2_style_reference.safetensors"
                    }
                ],
                "arguments": {
                    "prompt": "variable:prompt",
                    "image": "variable:input_image",
                    "height": 1024,
                    "width": 1024,
                    "num_inference_steps": 8,
                    "guidance_scale": 0.0
                }
            },
            "result": {
                "content_type": "image/jpeg"
            }
        }
    ]
}