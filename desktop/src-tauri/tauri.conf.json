{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "diffusers-workflow",
  "identifier": "com.dkackman.diffusers-workflow",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "diffusers-workflow",
        "width": 1280,
        "height": 860,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["dmg", "msi", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "resources/uv": "uv",
      "resources/python": "python",
      "resources/seed": "seed"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/dkackman/diffusers-workflow/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcwMEJEQzBERThEODQ5OUYKUldTZlNkam9EZHdMY09GMFNQY2xPRzVFbkhEeXhkOFVpUDM0bHhOWUZkQnNzdzVyWXlLYjFYc1MK"
    }
  }
}
