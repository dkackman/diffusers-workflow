{
    "id": "LumenFinish",
    "description": "Pass 3 of LUMEN - the finish. The eight H3 shots LumenFilm.json wrote are joined with cross-dissolves and faded in and out of black ('dissolve_videos'), then RIFE doubles the frame rate to 48 fps for the slow, silky motion a nature film wants ('interpolate_frames'). The Music3 score is sliced to the dissolved length (each seam shortens the cut by one overlap), given a musical fade-out and normalized, and laid under the picture with 'pair_audio'. Runs from saved files on a box that is otherwise idle - nothing here needs the generation models.",
    "variables": {
        "score": "workflows/lumen/assets/lumen/Lumen-score_choir.9-0.0.wav",
        "sample_rate": 44100,
        "fps": 24,
        "dissolve_frames": 12,
        "fade_in_frames": 12,
        "fade_out_frames": 36,
        "total_frames": 908,
        "multiplier": 2,
        "shot_1_dawn_lake": {
            "media_type": "video",
            "location": "assets/lumen/LumenFilm-shot_1_dawn_lake.1-0.0.mp4"
        },
        "shot_2_barley_wind": {
            "media_type": "video",
            "location": "assets/lumen/LumenFilm-shot_2_barley_wind.2-0.0.mp4"
        },
        "shot_3_redwood_rays": {
            "media_type": "video",
            "location": "assets/lumen/LumenFilm-shot_3_redwood_rays.3-0.0.mp4"
        },
        "shot_4_rainbow_falls": {
            "media_type": "video",
            "location": "assets/lumen/LumenFilm-shot_4_rainbow_falls.4-0.0.mp4"
        },
        "shot_5_sunset_dunes": {
            "media_type": "video",
            "location": "assets/lumen/LumenFilm-shot_5_sunset_dunes.5-0.0.mp4"
        },
        "shot_6_sky_lanterns": {
            "media_type": "video",
            "location": "assets/lumen/LumenFilm-shot_6_sky_lanterns.6-0.0.mp4"
        },
        "shot_7_glowing_surf": {
            "media_type": "video",
            "location": "assets/lumen/LumenFilm-shot_7_glowing_surf.7-0.0.mp4"
        },
        "shot_8_aurora_ice": {
            "media_type": "video",
            "location": "assets/lumen/LumenFilm-shot_8_aurora_ice.8-0.0.mp4"
        }
    },
    "seed": 7,
    "steps": [
        {
            "name": "soundtrack",
            "task": {
                "command": "slice_audio",
                "arguments": {
                    "audio": "variable:score",
                    "start_frame": 0,
                    "num_frames": "variable:total_frames",
                    "fps": "variable:fps"
                }
            }
        },
        {
            "name": "faded",
            "task": {
                "command": "fade_audio",
                "arguments": {
                    "audio": "previous_result:soundtrack",
                    "fade_in_ms": 400,
                    "fade_out_ms": 2500,
                    "sample_rate": "variable:sample_rate"
                }
            }
        },
        {
            "name": "score_final",
            "task": {
                "command": "normalize_audio",
                "arguments": {
                    "audio": "previous_result:faded",
                    "peak_dbfs": -1.0,
                    "sample_rate": "variable:sample_rate"
                }
            }
        },
        {
            "name": "dissolve",
            "task": {
                "command": "dissolve_videos",
                "arguments": {
                    "videos": [
                        "variable:shot_1_dawn_lake",
                        "variable:shot_2_barley_wind",
                        "variable:shot_3_redwood_rays",
                        "variable:shot_4_rainbow_falls",
                        "variable:shot_5_sunset_dunes",
                        "variable:shot_6_sky_lanterns",
                        "variable:shot_7_glowing_surf",
                        "variable:shot_8_aurora_ice"
                    ],
                    "dissolve_frames": "variable:dissolve_frames",
                    "fade_in_frames": "variable:fade_in_frames",
                    "fade_out_frames": "variable:fade_out_frames",
                    "fps": "variable:fps"
                }
            }
        },
        {
            "name": "lumen_24fps",
            "task": {
                "command": "pair_audio",
                "arguments": {
                    "video": "previous_result:dissolve",
                    "audio": "previous_result:score_final",
                    "sample_rate": "variable:sample_rate"
                }
            },
            "result": {
                "content_type": "video/mp4",
                "fps": 24
            }
        },
        {
            "name": "interpolate",
            "task": {
                "command": "interpolate_frames",
                "arguments": {
                    "video": "previous_result:dissolve",
                    "multiplier": "variable:multiplier",
                    "device": "cuda"
                }
            }
        },
        {
            "name": "lumen_48fps",
            "task": {
                "command": "pair_audio",
                "arguments": {
                    "video": "previous_result:interpolate",
                    "audio": "previous_result:score_final",
                    "sample_rate": "variable:sample_rate"
                }
            },
            "result": {
                "content_type": "video/mp4",
                "fps": 48
            }
        }
    ]
}