{
    "id": "minimax-h3-image",
    "description": "MiniMax-H3-Image as a model entry, configured by the text-to-image template: a fixed 6-step sampler with no step count, guidance or negative prompt, a canvas in multiples of 32, int8 SDNQ with group offload, under 6 GB of VRAM and about 64 GB of host RAM warm (about 120 GB on a cold first run while it quantizes). CUDA only. For references run templates/minimax-h3-image/multi-reference.",
    "configures": "templates/text-to-image",
    "cost": [
        {
            "device": "cuda",
            "name": "RTX 3090",
            "vram_gb": 24,
            "minutes": 2.0
        }
    ],
    "cost_drivers": [
        "width",
        "height"
    ],
    "host_ram_gb": 64,
    "variables": {
        "prompt": "an apple on a wooden table, soft window light",
        "width": 2048,
        "height": 2048,
        "weights_dtype": "{int8}",
        "seed": null
    },
    "seed": "variable:seed",
    "steps": [
        {
            "name": "text_to_image",
            "pipeline": {
                "configuration": {
                    "component_type": "ModularPipeline",
                    "pre_load_modules": [
                        "sdnq"
                    ],
                    "load_components": {
                        "dtype": "torch.bfloat16",
                        "pretrained_model_name_or_path": {
                            "text_encoder": "MiniMaxAI/MiniMax-H3"
                        },
                        "revision": {
                            "text_encoder": "0919fb684102ef115126612f3fbb84d1027e7317"
                        },
                        "quantization_config": {
                            "transformer": {
                                "configuration": {
                                    "config_type": "sdnq.SDNQConfig"
                                },
                                "arguments": {
                                    "weights_dtype": "variable:weights_dtype",
                                    "quantization_device": "cuda",
                                    "return_device": "cpu",
                                    "use_quantized_matmul": true,
                                    "dequantize_fp32": false,
                                    "modules_to_not_convert": [
                                        "proj_in",
                                        "context_embedder",
                                        "time_embedder",
                                        "time_proj",
                                        "token_refiner",
                                        "norm_out",
                                        "pdd_proj_out"
                                    ]
                                }
                            },
                            "text_encoder": {
                                "configuration": {
                                    "config_type": "sdnq.SDNQConfig"
                                },
                                "arguments": {
                                    "weights_dtype": "variable:weights_dtype",
                                    "quantization_device": "cuda",
                                    "return_device": "cpu",
                                    "dequantize_fp32": false,
                                    "modules_to_not_convert": [
                                        ".model.visual",
                                        "lm_head"
                                    ]
                                }
                            }
                        }
                    },
                    "components": {
                        "transformer": {
                            "group_offload": {
                                "offload_type": "block_level",
                                "num_blocks_per_group": 2,
                                "use_stream": true,
                                "record_stream": true,
                                "low_cpu_mem_usage": true
                            }
                        },
                        "text_encoder": {
                            "remove_modules": [
                                "lm_head"
                            ]
                        },
                        "text_encoder.model": {
                            "truncate_layers": {
                                "language_model.layers": 51
                            },
                            "group_offload": {
                                "offload_type": "leaf_level"
                            }
                        },
                        "vae": {
                            "device": "cuda",
                            "residency": "on_demand"
                        }
                    }
                },
                "from_pretrained_arguments": {
                    "model_name": "MiniMaxAI/MiniMax-H3-Image"
                },
                "arguments": {
                    "prompt": "variable:prompt",
                    "width": "variable:width",
                    "height": "variable:height",
                    "output": "images"
                }
            },
            "result": {
                "content_type": "image/png",
                "subfolder": "final"
            }
        }
    ],
    "variable_constraints": {
        "width": {
            "modulus": 32,
            "remainder": 0,
            "reason": "MiniMax-H3-Image's canvas is a multiple of 32 (the VAE's 16x compression times the transformer's 2x2 patch), and its pipeline refuses one that is not only after the weights have loaded; refused here instead, with no 'snap', since rounding would be a silent change to the size asked for"
        },
        "height": {
            "modulus": 32,
            "remainder": 0,
            "reason": "MiniMax-H3-Image's canvas is a multiple of 32 (the VAE's 16x compression times the transformer's 2x2 patch), and its pipeline refuses one that is not only after the weights have loaded; refused here instead, with no 'snap', since rounding would be a silent change to the size asked for"
        }
    }
}
