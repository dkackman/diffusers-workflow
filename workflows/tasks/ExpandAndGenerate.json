{
  "id": "ExpandAndGenerate",
  "description": "Expands a short prompt with a language model, then generates with FLUX.1 dev.",
  "variables": {
    "prompt": "a cat sitting on a windowsill",
    "system_prompt": "prompt:prompt_enhancement/text_to_image"
  },
  "steps": [
    {
      "name": "expand",
      "task": {
        "command": "text_generation",
        "arguments": {
          "prompt": "variable:prompt",
          "system_prompt": "variable:system_prompt"
        }
      },
      "result": {
        "content_type": "text/plain",
        "save": false
      }
    },
    {
      "name": "generate",
      "pipeline": {
        "configuration": {
          "component_type": "DiffusionPipeline"
        },
        "from_pretrained_arguments": {
          "model_name": "stable-diffusion-v1-5/stable-diffusion-v1-5",
          "torch_dtype": "torch.bfloat16"
        },
        "arguments": {
          "prompt": "previous_result:expand",
          "num_inference_steps": 25,
          "guidance_scale": 3.5
        }
      },
      "result": {
        "content_type": "image/png",
        "embed_metadata": true
      }
    }
  ]
}
