{
    "variables": {
        "prompt": "saturd4ym0rning, a spunky robot dog sidekick with antenna ears skateboarding through a neon-colored treehouse fort, exaggerated cel-shaded outlines, bold flat colors, retro Saturday morning cartoon style, dynamic action pose, halftone shading",
        "negative_prompt": "photorealistic, photo, realistic skin, 3d render, live action, muted colors, sketch, blurry, low quality",
        "num_images_per_prompt": 4,
        "num_inference_steps": 9,
        "guidance_scale": 0.0,
        "width": 960,
        "height": 544
    },
    "id": "ZImageSaturdayMorning",
    "description": "Text-to-image with Z-Image Turbo and the Saturday-Morning-Z-Image-Turbo LoRA - retro Saturday morning cartoon style.",
    "steps": [
        {
            "name": "txt2img",
            "pipeline": {
                "configuration": {
                    "component_type": "ZImagePipeline",
                    "offload": "sequential"
                },
                "from_pretrained_arguments": {
                    "model_name": "Tongyi-MAI/Z-Image-Turbo",
                    "torch_dtype": "torch.bfloat16",
                    "low_cpu_mem_usage": true
                },
                "loras": [
                    {
                        "model_name": "renderartist/Saturday-Morning-Z-Image-Turbo",
                        "adapter_name": "saturday_morning",
                        "scale": 1.0
                    }
                ],
                "arguments": {
                    "prompt": "variable:prompt",
                    "negative_prompt": "variable:negative_prompt",
                    "num_inference_steps": "variable:num_inference_steps",
                    "num_images_per_prompt": "variable:num_images_per_prompt",
                    "width": "variable:width",
                    "height": "variable:height",
                    "guidance_scale": "variable:guidance_scale"
                }
            },
            "result": {
                "content_type": "image/jpeg",
                "embed_metadata": true
            }
        }
    ]
}
