{
    "id": "GyreFrames",
    "description": "Pass 2 of GYRE - registration. Each source still is re-framed by recenter_crop around its own spiral's centre, at a crop chosen so every bounded subject lands at the same size in the 704x704 frame. Nothing here is generated; this pass only decides where each picture is looked at from. It is what makes the hard cuts in GyreFilm.json land in register, so that the shape appears to survive while the world under it is replaced.",
    "variables": {
        "width": 704,
        "height": 704,
        "src_1_iris": {
            "location": "assets/src_1_iris.jpg"
        },
        "src_2_fingerprint": {
            "location": "assets/src_2_fingerprint.jpg"
        },
        "src_3_fiddlehead": {
            "location": "assets/src_3_fiddlehead.jpg"
        },
        "src_4_nautilus": {
            "location": "assets/src_4_nautilus.jpg"
        },
        "src_5_web": {
            "location": "assets/src_5_web.jpg"
        },
        "src_6_whirlpool": {
            "location": "assets/src_6_whirlpool.jpg"
        },
        "src_7_hurricane": {
            "location": "assets/src_7_hurricane.jpg"
        },
        "src_8_galaxy": {
            "location": "assets/src_8_galaxy.jpg"
        },
        "src_9_return": {
            "location": "assets/src_9_return.jpg"
        }
    },
