{
    "id": "LTX2RefineClip",
    "description": "Refines a clip from the asset library at exactly twice its size through LTX-2.5's stage-two path, starting from the clip's own latents rather than a reference: the latent upsampler VAE-encodes the source, doubles the latents, and 'refine' renoises them at 0.909375 and runs the three stage-two distilled sigmas - two-stage's refine pass, fed a clip dw did not make. Composition and motion are the source's; fine texture is regenerated at that noise level, so it is not a faithful resize. 'width'/'height' are the working size the source is fitted to (each divisible by 32), and 'num_frames' (8 * n + 1) its working length; the model renders at twice that, and a last step restores the result to twice the source's size at the source's own length - so the output is exactly 2x the source whatever its size. A different aspect ratio is handled by 'fit': letterbox (default) pads it and the padding is cut back off, stretch resizes it, crop cuts it to fill. A source shorter than 'num_frames' is held on its last frame and trimmed back after; a longer one is cut to its opening 'num_frames' frames. Defaults work at 512x288, 121 frames, 24 fps - set 'frame_rate' to the source's (get_gallery_metadata('asset:...') reads it). Replace the default prompt with a description of the source's subject, setting, motion and lighting. The soundtrack is the source's own, not generated: its track is read and normalized to -3 dBFS as the first step, so a source with no soundtrack is refused there, before any pipeline loads, and the refined picture (saved to intermediate/) is paired with it, cut to the output length, in final/. Versus upscale-clip: that template re-renders with the source as an IC-LoRA reference (invented detail, gated LoRA download); this one keeps the source's own latents, needs no LoRA and denoises three sigmas rather than eight.",
    "summary": "2x latent refine of your own clip, any aspect or length, soundtrack kept. width/height = the working size.",
    "cost": [
        {
            "device": "cuda",
            "name": "RTX 3090",
            "vram_gb": 24,
            "minutes": 2.9
        }
    ],
    "cost_drivers": [
        "num_frames",
        "width",
        "height"
    ],
    "variables": {
        "transformer_weights_dtype": "{uint4}",
        "text_encoder_weights_dtype": "{int8}",
        "source_video": "asset:clip.mp4",
        "prompt": "A high-resolution rendering of the source footage, with the same subject, framing, motion and lighting, and sharp, fine detail.",
        "negative_prompt": "constant:diffusers.pipelines.ltx2.utils.DEFAULT_NEGATIVE_PROMPT",
        "width": 512,
        "height": 288,
        "num_frames": 121,
        "frame_rate": 24.0,
        "fit": "letterbox",
        "seed": 42
    },
    "variable_constraints": {
        "width": {
            "modulus": 32,
            "remainder": 0,
            "reason": "LTX-2.5's pipelines refuse a width not divisible by 32 outright (ValueError, not a silent floor), so it is checked here before the pipeline loads rather than after it"
        },
        "height": {
            "modulus": 32,
            "remainder": 0,
            "reason": "LTX-2.5's pipelines refuse a height not divisible by 32 outright (ValueError, not a silent floor), so it is checked here before the pipeline loads rather than after it"
        },
        "num_frames": {
            "modulus": 8,
            "remainder": 1,
            "min_frames": 9,
            "reason": "LTX-2.5's video VAE encodes 8 * n + 1 frames, so an off-grid count is not refused by the pipeline but floored to the grid below - a shorter clip than the one asked for. Refused here instead: no 'snap', because rounding a length the other way from the pipeline's own would be a second silent change"
        }
    },
    "seed": "variable:seed",
    "steps": [
        {
            "name": "source_audio",
            "task": {
                "command": "normalize_audio",
                "arguments": {
                    "audio": "variable:source_video",
                    "peak_dbfs": -3.0
                }
            }
        },
        {
            "name": "fit",
            "task": {
                "command": "fit_to_model",
                "arguments": {
                    "video": "variable:source_video",
                    "width": "variable:width",
                    "height": "variable:height",
                    "num_frames": "variable:num_frames",
                    "mode": "variable:fit"
                }
            },
            "result": {
                "content_type": "video/mp4",
                "save": false
            }
        },
        {
            "name": "upscale",
            "pipeline": {
                "configuration": {
                    "component_type": "LTX2LatentUpsamplePipeline",
                    "shared_components": [
                        "vae"
                    ],
                    "vae": {
                        "enable_tiling": true
                    }
                },
                "from_pretrained_arguments": {},
                "vae": {
                    "configuration": {
                        "component_type": "AutoencoderKLLTX2Video"
                    },
                    "from_pretrained_arguments": {
                        "model_name": "Lightricks/LTX-2.5-Diffusers",
                        "subfolder": "vae",
                        "torch_dtype": "torch.bfloat16"
                    }
                },
                "latent_upsampler": {
                    "configuration": {
                        "component_type": "diffusers.pipelines.ltx2.latent_upsampler.LTX2LatentUpsamplerModel"
                    },
                    "from_pretrained_arguments": {
                        "model_name": "Lightricks/LTX-2.5-Diffusers",
                        "subfolder": "latent_upsampler",
                        "torch_dtype": "torch.bfloat16"
                    }
                },
                "arguments": {
                    "video": "previous_result:fit.video",
                    "width": "variable:width",
                    "height": "variable:height",
                    "num_frames": "variable:num_frames",
                    "adain_factor": 0.0,
                    "tone_map_compression_ratio": 0.0,
                    "output_type": "{latent}"
                }
            },
            "result": {
                "content_type": "video/mp4",
                "save": false,
                "fps": "variable:frame_rate"
            }
        },
        {
            "name": "refine",
            "release_pipeline": true,
            "pipeline": {
                "configuration": {
                    "component_type": "LTX2Pipeline",
                    "pre_load_modules": [
                        "sdnq"
                    ],
                    "components": {
                        "transformer": {
                            "device": "cuda"
                        },
                        "text_encoder": {
                            "group_offload": {
                                "offload_type": "leaf_level",
                                "use_stream": true
                            }
                        },
                        "connectors": {
                            "group_offload": {
                                "offload_type": "leaf_level",
                                "use_stream": true
                            }
                        },
                        "audio_vae": {
                            "device": "cuda"
                        },
                        "vocoder": {
                            "device": "cuda"
                        },
                        "duration_head": {
                            "device": "cuda"
                        }
                    },
                    "vae": {
                        "enable_tiling": true
                    },
                    "reused_components": [
                        "vae"
                    ]
                },
                "from_pretrained_arguments": {
                    "model_name": "Lightricks/LTX-2.5-Diffusers",
                    "torch_dtype": "torch.bfloat16"
                },
                "transformer": {
                    "configuration": {
                        "component_type": "LTX2VideoTransformer3DModel",
                        "preserve_device_placement": true
                    },
                    "quantization_config": {
                        "configuration": {
                            "config_type": "sdnq.SDNQConfig"
                        },
                        "arguments": {
                            "weights_dtype": "variable:transformer_weights_dtype",
                            "quantization_device": "cuda",
                            "return_device": "cuda",
                            "use_quantized_matmul": true,
                            "dequantize_fp32": false
                        }
                    },
                    "from_pretrained_arguments": {
                        "model_name": "Lightricks/LTX-2.5-Diffusers",
                        "subfolder": "transformer",
                        "torch_dtype": "torch.bfloat16"
                    }
                },
                "text_encoder": {
                    "configuration": {
                        "component_type": "transformers.Gemma4UnifiedForConditionalGeneration",
                        "preserve_device_placement": true
                    },
                    "quantization_config": {
                        "configuration": {
                            "config_type": "sdnq.SDNQConfig"
                        },
                        "arguments": {
                            "weights_dtype": "variable:text_encoder_weights_dtype",
                            "quantization_device": "cuda",
                            "return_device": "cpu",
                            "dequantize_fp32": false,
                            "modules_to_not_convert": [
                                "embed_vision",
                                "embed_audio",
                                "lm_head"
                            ]
                        }
                    },
                    "from_pretrained_arguments": {
                        "model_name": "Lightricks/LTX-2.5-Diffusers",
                        "subfolder": "text_encoder",
                        "torch_dtype": "torch.bfloat16"
                    }
                },
                "arguments": {
                    "prompt": "variable:prompt",
                    "negative_prompt": "variable:negative_prompt",
                    "latents": "previous_result:upscale.frames",
                    "noise_scale": 0.909375,
                    "sigmas": "constant:diffusers.pipelines.ltx2.utils.STAGE_2_DISTILLED_SIGMA_VALUES",
                    "width": "variable:width",
                    "height": "variable:height",
                    "num_frames": "variable:num_frames",
                    "frame_rate": "variable:frame_rate",
                    "guidance_scale": 1.0,
                    "audio_guidance_scale": 1.0,
                    "stg_scale": 0.0,
                    "audio_stg_scale": 0.0,
                    "modality_scale": 1.0,
                    "audio_modality_scale": 1.0,
                    "output_type": "{np}"
                }
            },
            "result": {
                "content_type": "video/mp4",
                "fps": "variable:frame_rate",
                "subfolder": "intermediate"
            }
        },
        {
            "name": "restore",
            "task": {
                "command": "restore_to_source",
                "arguments": {
                    "video": "previous_result:refine",
                    "fit": "previous_result:fit.fit"
                }
            },
            "result": {
                "content_type": "video/mp4",
                "save": false,
                "fps": "variable:frame_rate"
            }
        },
        {
            "name": "with_source_audio",
            "task": {
                "command": "pair_audio",
                "arguments": {
                    "video": "previous_result:restore",
                    "audio": "previous_result:source_audio",
                    "fit": "video"
                }
            },
            "result": {
                "content_type": "video/mp4",
                "fps": "variable:frame_rate",
                "subfolder": "final"
            }
        }
    ]
}
