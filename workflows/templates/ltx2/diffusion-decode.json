{
    "id": "LTX2DiffusionDecode",
    "description": "An A/B against `text-to-video`, and nothing else. LTX-2.5 ships a second video decoder - `LTX2VideoDiffusionDecodePipeline`, a small diffusion model that denoises pixels from a context volume built out of the latents rather than deconvolving them - and upstream treats it as the production path. The generation step here is `text-to-video`'s, argument for argument, stopped at 'output_type': 'latent' so the latents come back undecoded; the decode step is the only difference. Same prompt, same seed, same sigma schedule, same canvas, so the two runs are comparable frame for frame and minute for minute. 'denormalize': false because the generation step already applied the latent statistics on its way out. It is silent: at 'output_type': 'latent' the soundtrack comes back as audio latents and this decoder is video-only, so the comparison is about the picture. IT NEEDS NATTEN AND WILL NOT RUN WITHOUT IT. The decoder's attention is a 3D neighborhood window, and diffusers ships two processors for it: NATTEN's `na3d` kernel, which encodes the window in the kernel, and a portable FlexAttention fallback that expresses it as a BlockMask. The fallback is the default and on a 24 GB card it does not decode at any size at all - measured on an otherwise empty RTX 3090 (#153): at 960x544x121 it asks for 10.05 GiB inside stages 1-3, at 512x288x25 it asks for 69.77 GiB for one stage-4 attention (or 17.44 GiB to densify that stage's block mask, whichever it reaches first), and at 224x224x25 - the smallest canvas the 7x7 kernel accepts at all - it needs about 25.5 GiB. Shrinking the clip does not help, because the stage-4 grid tracks output resolution either way, and tiling does not either, because stages 1-3 always run on the full volume. That is why this template names `LTX2VideoVaeNeighborhoodNattenProcessor` explicitly rather than taking the default: the kernel comes from the Hub through the `kernels` package, so the decode step needs a `shi-labs/natten` build matching the installed torch, and it fails at load saying so when there is none. If the decode runs and is merely tight, `enable_tiling` on `diffusion_decoder` is the next knob. Whether the picture is worth the minutes is still the open question; record both.",
    "cost_drivers": [
        "num_frames",
        "width",
        "height"
    ],
    "variables": {
        "transformer_weights_dtype": "{uint4}",
        "text_encoder_weights_dtype": "{int8}",
        "prompt": "prompt:ltx2/fox_dawn_choir",
        "negative_prompt": "constant:diffusers.pipelines.ltx2.utils.DEFAULT_NEGATIVE_PROMPT",
        "width": 960,
        "height": 544,
        "num_frames": 121,
        "frame_rate": 24.0,
        "seed": 42
    },
    "variable_constraints": {
        "num_frames": {
            "modulus": 8,
            "remainder": 1,
            "min_frames": 9,
            "reason": "LTX-2.5's video VAE encodes 8 * n + 1 frames, so an off-grid count is not refused by the pipeline but floored to the grid below - a shorter clip than the one asked for. Refused here instead: no 'snap', because rounding a length the other way from the pipeline's own would be a second silent change"
        }
    },
    "seed": "variable:seed",
    "steps": [
        {
            "name": "latents",
            "pipeline": {
                "configuration": {
                    "component_type": "LTX2Pipeline",
                    "pre_load_modules": [
                        "sdnq"
                    ],
                    "components": {
                        "transformer": {
                            "device": "cuda"
                        },
                        "text_encoder": {
                            "group_offload": {
                                "offload_type": "leaf_level",
                                "use_stream": true
                            }
                        },
                        "connectors": {
                            "group_offload": {
                                "offload_type": "leaf_level",
                                "use_stream": true
                            }
                        },
                        "vae": {
                            "device": "cuda"
                        },
                        "audio_vae": {
                            "device": "cuda"
                        },
                        "vocoder": {
                            "device": "cuda"
                        },
                        "duration_head": {
                            "device": "cuda"
                        }
                    }
                },
                "from_pretrained_arguments": {
                    "model_name": "Lightricks/LTX-2.5-Diffusers",
                    "torch_dtype": "torch.bfloat16"
                },
                "transformer": {
                    "configuration": {
                        "component_type": "LTX2VideoTransformer3DModel",
                        "preserve_device_placement": true
                    },
                    "quantization_config": {
                        "configuration": {
                            "config_type": "sdnq.SDNQConfig"
                        },
                        "arguments": {
                            "weights_dtype": "variable:transformer_weights_dtype",
                            "quantization_device": "cuda",
                            "return_device": "cuda",
                            "use_quantized_matmul": true,
                            "dequantize_fp32": false
                        }
                    },
                    "from_pretrained_arguments": {
                        "model_name": "Lightricks/LTX-2.5-Diffusers",
                        "subfolder": "transformer",
                        "torch_dtype": "torch.bfloat16"
                    }
                },
                "text_encoder": {
                    "configuration": {
                        "component_type": "transformers.Gemma4UnifiedForConditionalGeneration",
                        "preserve_device_placement": true
                    },
                    "quantization_config": {
                        "configuration": {
                            "config_type": "sdnq.SDNQConfig"
                        },
                        "arguments": {
                            "weights_dtype": "variable:text_encoder_weights_dtype",
                            "quantization_device": "cuda",
                            "return_device": "cpu",
                            "dequantize_fp32": false,
                            "modules_to_not_convert": [
                                "embed_vision",
                                "embed_audio",
                                "lm_head"
                            ]
                        }
                    },
                    "from_pretrained_arguments": {
                        "model_name": "Lightricks/LTX-2.5-Diffusers",
                        "subfolder": "text_encoder",
                        "torch_dtype": "torch.bfloat16"
                    }
                },
                "arguments": {
                    "prompt": "variable:prompt",
                    "negative_prompt": "variable:negative_prompt",
                    "width": "variable:width",
                    "height": "variable:height",
                    "num_frames": "variable:num_frames",
                    "frame_rate": "variable:frame_rate",
                    "sigmas": "constant:diffusers.pipelines.ltx2.utils.DISTILLED_SIGMA_VALUES",
                    "guidance_scale": 1.0,
                    "audio_guidance_scale": 1.0,
                    "stg_scale": 0.0,
                    "audio_stg_scale": 0.0,
                    "modality_scale": 1.0,
                    "audio_modality_scale": 1.0,
                    "output_type": "{latent}"
                }
            },
            "release_pipeline": true
        },
        {
            "name": "diffusion_decode",
            "pipeline": {
                "configuration": {
                    "component_type": "LTX2VideoDiffusionDecodePipeline",
                    "components": {
                        "diffusion_decoder": {
                            "device": "cuda",
                            "attn_processor_type": "diffusers.models.autoencoders.ltx2_diffusion_decoder.LTX2VideoVaeNeighborhoodNattenProcessor"
                        },
                        "vae": {
                            "device": "cuda"
                        }
                    }
                },
                "from_pretrained_arguments": {
                    "model_name": "Lightricks/LTX-2.5-Diffusers",
                    "torch_dtype": "torch.bfloat16"
                },
                "arguments": {
                    "latents": "previous_result:latents.frames",
                    "denormalize": false,
                    "output_type": "{np}"
                }
            },
            "result": {
                "content_type": "video/mp4",
                "fps": 24,
                "subfolder": "final"
            }
        }
    ],
    "summary": "text-to-video's clip, decoded by LTX-2.5's diffusion decoder rather than the conv VAE."
}
