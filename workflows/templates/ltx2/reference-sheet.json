{
    "id": "LTX2ReferenceSheet",
    "description": "Holds a cast, their props and their set consistent across a clip by conditioning on a reference sheet - one composite image with a clean panel per element, which is how the LTX-2.5 line does identity. This is the family's only reference template: everything else here pins appearance through a first or last frame, which fixes one moment rather than a subject. The sheet is supplied as a still and looped into a static video by the first step, because the IC-LoRA reads it as reference latents and was trained with the sheet held for the whole clip - 'reference_frames' must be at least 121 or the 121-frame read bucket is missed, and it defaults to matching 'num_frames'. Authoring the sheet is the work: a front-facing close-up plus a full turnaround for each character, a product-style render of each prop, one clean location panel, no text, and bigger panels for the elements that matter most - what is not on the sheet will not appear, and what is small or crowded carries over worst. The prompt is in the two-part trained form, 'Reference sheet:' naming the panels and 'Generated video:' driving the action. The LoRA is a 0.9 preview weight trained at 768x448, 121 frames, 24 fps, which is what the defaults are.",
    "summary": "Holds a cast, their props and their set consistent across a clip by conditioning on a reference sheet.",
    "cost_drivers": [
        "num_frames",
        "width",
        "height"
    ],
    "variables": {
        "transformer_weights_dtype": "{uint4}",
        "text_encoder_weights_dtype": "{int8}",
        "reference_sheet": "asset:reference_sheet.png",
        "prompt": "prompt:ltx2/reference_sheet_workshop",
        "negative_prompt": "constant:diffusers.pipelines.ltx2.utils.DEFAULT_NEGATIVE_PROMPT",
        "width": 768,
        "height": 448,
        "num_frames": 121,
        "reference_frames": 121,
        "frame_rate": 24.0,
        "lora_scale": 1.0,
        "seed": 42
    },
    "variable_constraints": {
        "num_frames": {
            "modulus": 8,
            "remainder": 1,
            "min_frames": 9,
            "reason": "LTX-2.5's video VAE encodes 8 * n + 1 frames, so an off-grid count is not refused by the pipeline but floored to the grid below - a shorter clip than the one asked for. Refused here instead: no 'snap', because rounding a length the other way from the pipeline's own would be a second silent change"
        },
        "reference_frames": {
            "min_frames": 121,
            "reason": "the Ingredients IC-LoRA reads the reference through a 121-frame bucket, and every target it was trained on was at least that long - a shorter static sheet breaks the reference encoding rather than shortening it"
        }
    },
    "seed": "variable:seed",
    "steps": [
        {
            "name": "static_sheet",
            "task": {
                "command": "loop_frames",
                "arguments": {
                    "video": {
                        "media_type": "image",
                        "location": "variable:reference_sheet"
                    },
                    "num_frames": "variable:reference_frames"
                }
            },
            "result": {
                "content_type": "video/mp4",
                "save": false
            }
        },
        {
            "name": "shot",
            "pipeline": {
                "configuration": {
                    "component_type": "LTX2InContextPipeline",
                    "pre_load_modules": [
                        "sdnq"
                    ],
                    "components": {
                        "transformer": {
                            "device": "cuda"
                        },
                        "text_encoder": {
                            "group_offload": {
                                "offload_type": "leaf_level",
                                "use_stream": true
                            }
                        },
                        "connectors": {
                            "group_offload": {
                                "offload_type": "leaf_level",
                                "use_stream": true
                            }
                        },
                        "vae": {
                            "device": "cuda"
                        },
                        "audio_vae": {
                            "device": "cuda"
                        },
                        "vocoder": {
                            "device": "cuda"
                        }
                    },
                    "vae": {
                        "enable_tiling": true
                    }
                },
                "from_pretrained_arguments": {
                    "model_name": "Lightricks/LTX-2.5-Diffusers",
                    "torch_dtype": "torch.bfloat16"
                },
                "transformer": {
                    "configuration": {
                        "component_type": "LTX2VideoTransformer3DModel",
                        "preserve_device_placement": true
                    },
                    "quantization_config": {
                        "configuration": {
                            "config_type": "sdnq.SDNQConfig"
                        },
                        "arguments": {
                            "weights_dtype": "variable:transformer_weights_dtype",
                            "quantization_device": "cuda",
                            "return_device": "cuda",
                            "use_quantized_matmul": true,
                            "dequantize_fp32": false
                        }
                    },
                    "from_pretrained_arguments": {
                        "model_name": "Lightricks/LTX-2.5-Diffusers",
                        "subfolder": "transformer",
                        "torch_dtype": "torch.bfloat16"
                    }
                },
                "text_encoder": {
                    "configuration": {
                        "component_type": "transformers.Gemma4UnifiedForConditionalGeneration",
                        "preserve_device_placement": true
                    },
                    "quantization_config": {
                        "configuration": {
                            "config_type": "sdnq.SDNQConfig"
                        },
                        "arguments": {
                            "weights_dtype": "variable:text_encoder_weights_dtype",
                            "quantization_device": "cuda",
                            "return_device": "cpu",
                            "dequantize_fp32": false,
                            "modules_to_not_convert": [
                                "embed_vision",
                                "embed_audio",
                                "lm_head"
                            ]
                        }
                    },
                    "from_pretrained_arguments": {
                        "model_name": "Lightricks/LTX-2.5-Diffusers",
                        "subfolder": "text_encoder",
                        "torch_dtype": "torch.bfloat16"
                    }
                },
                "arguments": {
                    "prompt": "variable:prompt",
                    "negative_prompt": "variable:negative_prompt",
                    "width": "variable:width",
                    "height": "variable:height",
                    "num_frames": "variable:num_frames",
                    "frame_rate": "variable:frame_rate",
                    "sigmas": "constant:diffusers.pipelines.ltx2.utils.DISTILLED_SIGMA_VALUES",
                    "guidance_scale": 1.0,
                    "audio_guidance_scale": 1.0,
                    "stg_scale": 0.0,
                    "audio_stg_scale": 0.0,
                    "modality_scale": 1.0,
                    "audio_modality_scale": 1.0,
                    "output_type": "{np}",
                    "reference_conditions": [
                        {
                            "reference_type": "diffusers.pipelines.ltx2.pipeline_ltx2_ic_lora.LTX2ReferenceCondition",
                            "from_arguments": {
                                "frames": "previous_result:static_sheet",
                                "strength": 1.0
                            }
                        }
                    ],
                    "reference_downscale_factor": 1,
                    "conditioning_attention_strength": 1.0
                },
                "loras": [
                    {
                        "model_name": "Lightricks/LTX-2.5-22b-IC-LoRA-Ingredients",
                        "weight_name": "ltx-2.5-22b-ic-lora-ingredients-0.9.safetensors",
                        "adapter_name": "ic_lora",
                        "scale": "variable:lora_scale"
                    }
                ]
            },
            "result": {
                "content_type": "video/mp4",
                "fps": "variable:frame_rate",
                "subfolder": "final"
            }
        }
    ]
}
