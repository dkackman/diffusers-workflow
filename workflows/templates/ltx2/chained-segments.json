{
    "id": "LTX2I2VChained",
    "description": "A long clip built from short ones. The chain re-runs the pipeline per segment, handing each the last frame of the one before, and stitches the frames and the generated audio back into a single video. `prompt` is used for every segment, so any line of dialogue in it is spoken again in each one; to give each segment its own action or line, pass `prompts`, a list with one prompt per segment (segment i uses prompts[min(i, len - 1)]). To ask for a length instead of a count, set `duration_seconds`; it overrides `segments` (the run logs that `segments` was ignored), and the plan derives the segments and the video and audio are trimmed to exactly that length. `look_hold` (default true) grades each later segment's opening to the frame it was handed and eases contrast, saturation and texture creep back to segment 1's, so the seams hold one look: it won the seam measures on the S5 tracking shot at both seeds, left an orbit's motion alone, and costs nothing measurable (bench/records/ltx.md); pass false for the plain chain. Cap a take at about 15-20 s (3-4 segments): past that the subject drifts and is replaced (bench/records/ltx.md), so cut and start the next shot from a fresh still of the subject.",
    "summary": "A long LTX-2.5 clip with audio, chained from short segments that each start on the previous one's last frame.",
    "cost_drivers": ["segments", "duration_seconds", "num_frames", "width", "height"],
    "variables": {
        "transformer_weights_dtype": "{uint4}",
        "text_encoder_weights_dtype": "{int8}",
        "prompt": "prompt:ltx2/marmot_robot_overlords",
        "prompts": null,
        "negative_prompt": "constant:diffusers.pipelines.ltx2.utils.DEFAULT_NEGATIVE_PROMPT",
        "width": 768,
        "height": 768,
        "frame_rate": 24.0,
        "num_frames": 121,
        "segments": 3,
        "duration_seconds": null,
        "look_hold": true,
        "image": {
            "location": "https://pbs.twimg.com/media/HPxFgsIXIAAjtUu?format=jpg&name=medium"
        },
        "seed": null
    },
    "variable_constraints": {
        "width": {
            "modulus": 32,
            "remainder": 0,
            "reason": "LTX-2.5's pipelines refuse a width not divisible by 32 outright (ValueError, not a silent floor), so it is checked here before the chain's first segment load rather than after it"
        },
        "height": {
            "modulus": 32,
            "remainder": 0,
            "reason": "LTX-2.5's pipelines refuse a height not divisible by 32 outright (ValueError, not a silent floor), so it is checked here before the chain's first segment load rather than after it"
        },
        "num_frames": {
            "modulus": 8,
            "remainder": 1,
            "min_frames": 9,
            "reason": "LTX-2.5's video VAE encodes 8 * n + 1 frames, so an off-grid count is not refused by the pipeline but floored to the grid below - a shorter clip than the one asked for. Refused here instead: no 'snap', because rounding a length the other way from the pipeline's own would be a second silent change"
        }
    },
    "seed": "variable:seed",
    "steps": [
        {
            "name": "chained_image_to_video",
            "pipeline": {
                "configuration": {
                    "component_type": "LTX2ImageToVideoPipeline",
                    "pre_load_modules": [
                        "sdnq"
                    ],
                    "components": {
                        "transformer": {
                            "device": "cuda"
                        },
                        "text_encoder": {
                            "group_offload": {
                                "offload_type": "leaf_level",
                                "use_stream": true
                            }
                        },
                        "connectors": {
                            "group_offload": {
                                "offload_type": "leaf_level",
                                "use_stream": true
                            }
                        },
                        "vae": {
                            "device": "cuda"
                        },
                        "audio_vae": {
                            "device": "cuda"
                        },
                        "vocoder": {
                            "device": "cuda"
                        },
                        "duration_head": {
                            "device": "cuda"
                        }
                    },
                    "vae": {
                        "enable_tiling": true
                    }
                },
                "from_pretrained_arguments": {
                    "model_name": "Lightricks/LTX-2.5-Diffusers",
                    "torch_dtype": "torch.bfloat16"
                },
                "transformer": {
                    "configuration": {
                        "component_type": "LTX2VideoTransformer3DModel",
                        "preserve_device_placement": true
                    },
                    "quantization_config": {
                        "configuration": {
                            "config_type": "sdnq.SDNQConfig"
                        },
                        "arguments": {
                            "weights_dtype": "variable:transformer_weights_dtype",
                            "quantization_device": "cuda",
                            "return_device": "cuda",
                            "use_quantized_matmul": true,
                            "dequantize_fp32": false
                        }
                    },
                    "from_pretrained_arguments": {
                        "model_name": "Lightricks/LTX-2.5-Diffusers",
                        "subfolder": "transformer",
                        "torch_dtype": "torch.bfloat16"
                    }
                },
                "text_encoder": {
                    "configuration": {
                        "component_type": "transformers.Gemma4UnifiedForConditionalGeneration",
                        "preserve_device_placement": true
                    },
                    "quantization_config": {
                        "configuration": {
                            "config_type": "sdnq.SDNQConfig"
                        },
                        "arguments": {
                            "weights_dtype": "variable:text_encoder_weights_dtype",
                            "quantization_device": "cuda",
                            "return_device": "cpu",
                            "dequantize_fp32": false,
                            "modules_to_not_convert": [
                                "embed_vision",
                                "embed_audio",
                                "lm_head"
                            ]
                        }
                    },
                    "from_pretrained_arguments": {
                        "model_name": "Lightricks/LTX-2.5-Diffusers",
                        "subfolder": "text_encoder",
                        "torch_dtype": "torch.bfloat16"
                    }
                },
                "chain": {
                    "segments": "variable:segments",
                    "duration_seconds": "variable:duration_seconds",
                    "prompts": "variable:prompts",
                    "continuity": "last_frame",
                    "segment_argument": "image",
                    "trim_frames": 2,
                    "crossfade_ms": 80,
                    "look_hold": "variable:look_hold",
                    "save_segments": true
                },
                "arguments": {
                    "prompt": "variable:prompt",
                    "negative_prompt": "variable:negative_prompt",
                    "image": "variable:image",
                    "width": "variable:width",
                    "height": "variable:height",
                    "num_frames": "variable:num_frames",
                    "frame_rate": "variable:frame_rate",
                    "sigmas": "constant:diffusers.pipelines.ltx2.utils.DISTILLED_SIGMA_VALUES",
                    "guidance_scale": 1.0,
                    "audio_guidance_scale": 1.0,
                    "stg_scale": 0.0,
                    "audio_stg_scale": 0.0,
                    "modality_scale": 1.0,
                    "audio_modality_scale": 1.0,
                    "output_type": "{np}"
                }
            },
            "result": {
                "content_type": "video/mp4",
                "fps": "variable:frame_rate",
                "subfolder": "final"
            }
        }
    ]
}
