{
    "id": "LTX2I2VEnhancePrompt",
    "description": "Handing the shot to the model. LTX-2.5's own prompt enhancer rewrites a one-line idea into the detailed prompt the model was trained on, conditioned on the reference frame, and the duration head picks the clip's length instead of a fixed frame count.",
    "variables": {
        "transformer_weights_dtype": "{uint4}",
        "text_encoder_weights_dtype": "{int8}",
        "prompt": "a marmot in a top hat and monocle sings to the camera",
        "negative_prompt": "constant:diffusers.pipelines.ltx2.utils.DEFAULT_NEGATIVE_PROMPT",
        "width": 768,
        "height": 768,
        "frame_rate": 24.0,
        "min_seconds": 2.0,
        "max_seconds": 8.0,
        "image": {
            "location": "https://pbs.twimg.com/media/HPxFgsIXIAAjtUu?format=jpg&name=medium"
        },
        "enhancer_weights_dtype": "{uint4}"
    },
    "steps": [
        {
            "name": "enhanced_image_to_video",
            "pipeline": {
                "configuration": {
                    "component_type": "LTX2ImageToVideoPipeline",
                    "pre_load_modules": [
                        "sdnq"
                    ],
                    "components": {
                        "transformer": {
                            "device": "cuda"
                        },
                        "text_encoder": {
                            "group_offload": {
                                "offload_type": "leaf_level",
                                "use_stream": true
                            }
                        },
                        "connectors": {
                            "group_offload": {
                                "offload_type": "leaf_level",
                                "use_stream": true
                            }
                        },
                        "vae": {
                            "device": "cuda"
                        },
                        "audio_vae": {
                            "device": "cuda"
                        },
                        "vocoder": {
                            "device": "cuda"
                        },
                        "duration_head": {
                            "device": "cuda"
                        },
                        "prompt_enhancer": {
                            "device": "cpu"
                        }
                    },
                    "vae": {
                        "enable_tiling": true
                    }
                },
                "from_pretrained_arguments": {
                    "model_name": "Lightricks/LTX-2.5-Diffusers",
                    "torch_dtype": "torch.bfloat16"
                },
                "transformer": {
                    "configuration": {
                        "component_type": "LTX2VideoTransformer3DModel",
                        "preserve_device_placement": true
                    },
                    "quantization_config": {
                        "configuration": {
                            "config_type": "sdnq.SDNQConfig"
                        },
                        "arguments": {
                            "weights_dtype": "variable:transformer_weights_dtype",
                            "quantization_device": "cuda",
                            "return_device": "cuda",
                            "use_quantized_matmul": true,
                            "dequantize_fp32": false
                        }
                    },
                    "from_pretrained_arguments": {
                        "model_name": "Lightricks/LTX-2.5-Diffusers",
                        "subfolder": "transformer",
                        "torch_dtype": "torch.bfloat16"
                    }
                },
                "text_encoder": {
                    "configuration": {
                        "component_type": "transformers.Gemma4UnifiedForConditionalGeneration",
                        "preserve_device_placement": true
                    },
                    "quantization_config": {
                        "configuration": {
                            "config_type": "sdnq.SDNQConfig"
                        },
                        "arguments": {
                            "weights_dtype": "variable:text_encoder_weights_dtype",
                            "quantization_device": "cuda",
                            "return_device": "cpu",
                            "dequantize_fp32": false,
                            "modules_to_not_convert": [
                                "embed_vision",
                                "embed_audio",
                                "lm_head"
                            ]
                        }
                    },
                    "from_pretrained_arguments": {
                        "model_name": "Lightricks/LTX-2.5-Diffusers",
                        "subfolder": "text_encoder",
                        "torch_dtype": "torch.bfloat16"
                    }
                },
                "arguments": {
                    "prompt": "variable:prompt",
                    "negative_prompt": "variable:negative_prompt",
                    "enable_prompt_enhancement": true,
                    "prompt_max_new_tokens": "constant:diffusers.pipelines.ltx2.utils.GEMMA4_PROMPT_ENHANCEMENT_CONFIG.max_new_tokens",
                    "image": "variable:image",
                    "width": "variable:width",
                    "height": "variable:height",
                    "min_seconds": "variable:min_seconds",
                    "max_seconds": "variable:max_seconds",
                    "frame_rate": "variable:frame_rate",
                    "sigmas": "constant:diffusers.pipelines.ltx2.utils.DISTILLED_SIGMA_VALUES",
                    "guidance_scale": 1.0,
                    "audio_guidance_scale": 1.0,
                    "stg_scale": 0.0,
                    "audio_stg_scale": 0.0,
                    "modality_scale": 1.0,
                    "audio_modality_scale": 1.0,
                    "output_type": "{np}"
                },
                "prompt_enhancer": {
                    "configuration": {
                        "component_type": "transformers.Gemma4ForConditionalGeneration",
                        "preserve_device_placement": true
                    },
                    "quantization_config": {
                        "configuration": {
                            "config_type": "sdnq.SDNQConfig"
                        },
                        "arguments": {
                            "weights_dtype": "variable:enhancer_weights_dtype",
                            "quantization_device": "cuda",
                            "return_device": "cpu",
                            "dequantize_fp32": false,
                            "modules_to_not_convert": [
                                "embed_vision",
                                "embed_audio",
                                "lm_head"
                            ]
                        }
                    },
                    "from_pretrained_arguments": {
                        "model_name": "google/gemma-4-E2B-it",
                        "torch_dtype": "torch.bfloat16"
                    }
                },
                "processor": {
                    "configuration": {
                        "component_type": "transformers.AutoProcessor"
                    },
                    "from_pretrained_arguments": {
                        "model_name": "google/gemma-4-E2B-it"
                    }
                }
            },
            "result": {
                "content_type": "video/mp4",
                "fps": 24
            }
        }
    ]
}
