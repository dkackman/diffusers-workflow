{
    "variables": {
        "prompt": "prompt:flux/weighted_portrait",
        "seed": null
    },
    "id": "FluxSchnellWeighted",
    "description": "FLUX.1 schnell with A1111-style (word:1.5) prompt weighting.",
    "seed": "variable:seed",
    "steps": [
        {
            "name": "txt2img",
            "pipeline": {
                "configuration": {
                    "component_type": "FluxPipeline",
                    "prompt_weighting": true,
                    "components": {
                        "transformer": {
                            "group_offload": {
                                "offload_type": "block_level",
                                "num_blocks_per_group": 1,
                                "use_stream": true,
                                "record_stream": true
                            }
                        },
                        "text_encoder": { "device": "cuda" },
                        "text_encoder_2": { "device": "cuda" },
                        "vae": { "device": "cuda" }
                    }
                },
                "from_pretrained_arguments": {
                    "model_name": "black-forest-labs/FLUX.1-schnell",
                    "torch_dtype": "torch.bfloat16"
                },
                "arguments": {
                    "prompt": "variable:prompt",
                    "num_inference_steps": 4,
                    "guidance_scale": 0.0,
                    "height": 1280,
                    "width": 896
                }
            },
            "result": {
                "content_type": "image/jpeg",
                "embed_metadata": true,
                "subfolder": "final"
            }
        }
    ]
}