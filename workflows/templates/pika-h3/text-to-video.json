                            "text_encoder": "0919fb684102ef115126612f3fbb84d1027e7317",
                            "vae": "0919fb684102ef115126612f3fbb84d1027e7317",
                            "audio_vae": "0919fb684102ef115126612f3fbb84d1027e7317",
