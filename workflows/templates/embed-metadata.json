{
    "id": "MetadataEmbed",
    "description": "FLUX.1 dev generation with full generation metadata embedded in the saved PNG.",
    "variables": {
        "prompt": "A serene mountain landscape at golden hour, photorealistic",
        "steps": 25,
        "seed": null
    },
    "seed": "variable:seed",
    "steps": [
        {
            "name": "generate",
            "pipeline": {
                "configuration": {
                    "components": {
                        "transformer": {
                            "group_offload": {
                                "offload_type": "block_level",
                                "num_blocks_per_group": 1,
                                "use_stream": true,
                                "record_stream": true
                            }
                        },
                        "text_encoder": { "device": "cuda" },
                        "text_encoder_2": { "device": "cuda" },
                        "vae": { "device": "cuda" }
                    },
                    "component_type": "FluxPipeline"
                },
                "from_pretrained_arguments": {
                    "model_name": "black-forest-labs/FLUX.1-dev",
                    "torch_dtype": "torch.bfloat16"
                },
                "arguments": {
                    "prompt": "variable:prompt",
                    "num_inference_steps": "variable:steps",
                    "guidance_scale": 3.5
                }
            },
            "result": {
                "content_type": "image/png",
                "embed_metadata": true,
                "subfolder": "final"
            }
        }
    ]
}
