{
    "id": "MiniMaxH3SeamPass",
    "description": "Smooths the seam jumps of a finished MiniMax-H3 take (a chain or a narrated-take passage) by re-denoising the whole take at low strength in overlapping time windows fused at every step (#1230). It smooths seams, not a burn fix: it wins seam jump on static, arc and dialogue chains and does not undo texture burn (bench/records/structural.md, Step 4). About 36-40 GPU-min per minute of take, about 16 GiB peak. 'source' is the take, an 'output:' or 'asset:' video, 24 fps with sides a multiple of 32; any length, since the windows lift H3's 15 s ceiling. Four steps: encode_h3_latents reads the take one 17-frame VAE clip at a time; an H3 t2va refine at 'refine_strength' (0.3; 0.2 is gentler) re-denoises it with 'refine_windows' at its defaults (42-latent windows, 12 overlap, pyramid blend, rebased positions), holding the take's own soundtrack, on the take's own canvas, and asks only for latents, so it skips its own VAE decode; decode_h3_latents trims the padding back to the take's length; pair_audio puts the take's own soundtrack back under it. 'prompt' should describe the take as a whole: it steers the low-strength redraw, not the staging. The cost row is one measured pass over a 26 s take on an RTX 3090, including the model load; it does not scale, since the take's length is read from the file at run time.",
    "summary": "Smooth the seam jumps of a finished H3 take with a low-strength windowed refine; smooths seams, not a burn fix.",
    "cost": [
        {
            "device": "cuda",
            "name": "RTX 3090",
            "vram_gb": 24,
            "minutes": 18.5
        }
    ],
    "cost_drivers": [
        "refine_strength",
        "num_inference_steps",
        "weights_dtype",
        "lora_model_name",
        "attention_backend",
        "cache"
    ],
    "variables": {
        "source": null,
        "prompt": "integrated_multimodal_description: [Shot 1] Cinematic, live-action, one continuous static shot. A young woman in a plain dark grey sweater stands centered in front of a flat painted wall of bold diagonal rainbow stripes with a black circle at upper left and a teal square at lower right. She breathes calmly, blinks, shifts her weight slightly and turns her head a little left and right, staying in place at the center of the frame. The painted wall stays exactly as it is, evenly lit by soft studio light. The camera is locked off on a tripod and never moves.\n\noverall_soundscape: Quiet studio room tone, the soft rustle of a wool sweater, calm breathing.\n\nnon_diegetic_music: N/A",
        "refine_strength": 0.3,
        "num_inference_steps": 5,
        "seed": null,
        "video_shift": 6.0,
        "audio_shift": 3.0,
        "weights_dtype": "{int4}",
        "lora_alpha": null,
        "lora_model_name": "lightx2v/Minimax-h3-Turbo",
        "lora_weight_name": "minimax_h3_fl2v_turbo_4step_v1.2_768p_bf16.safetensors",
        "attention_backend": "sparse",
        "sparse_tau": 0.5,
        "sparse_topk": 0.15,
        "cache": null
    },
    "variable_constraints": {
        "source": {
            "required": true,
            "reason": "the finished take to smooth, an 'output:' or 'asset:' video; there is no sensible default take"
        }
    },
    "seed": "variable:seed",
    "steps": [
        {
            "name": "encode",
            "task": {
                "command": "encode_h3_latents",
                "arguments": {
                    "source": "variable:source"
                }
            },
            "release_models": true
        },
        {
            "name": "refine",
            "release_pipeline": true,
            "pipeline": {
                "configuration": {
                    "component_type": "ModularPipeline",
                    "pre_load_modules": [
                        "sdnq"
                    ],
                    "load_components": {
                        "dtype": "torch.bfloat16",
                        "quantization_config": {
                            "transformer": {
                                "configuration": {
                                    "config_type": "sdnq.SDNQConfig"
                                },
                                "arguments": {
                                    "weights_dtype": "variable:weights_dtype",
                                    "quantization_device": "cuda",
                                    "return_device": "cpu",
                                    "use_quantized_matmul": true,
                                    "dequantize_fp32": false,
                                    "modules_to_not_convert": [
                                        "proj_in",
                                        "audio_proj_in",
                                        "context_embedder",
                                        "time_embedder",
                                        "time_proj",
                                        "token_refiner",
                                        "norm_out",
                                        "proj_out",
                                        "audio_proj_out"
                                    ]
                                }
                            },
                            "text_encoder": {
                                "configuration": {
                                    "config_type": "sdnq.SDNQConfig"
                                },
                                "arguments": {
                                    "weights_dtype": "variable:weights_dtype",
                                    "quantization_device": "cuda",
                                    "return_device": "cpu",
                                    "dequantize_fp32": false,
                                    "modules_to_not_convert": [
                                        ".model.visual",
                                        "lm_head"
                                    ]
                                }
                            },
                            "vae": {
                                "configuration": {
                                    "config_type": "sdnq.SDNQConfig"
                                },
                                "arguments": {
                                    "weights_dtype": "{int8}",
                                    "quant_conv": true,
                                    "use_quantized_matmul_conv": true,
                                    "quantization_device": "cuda",
                                    "return_device": "cpu",
                                    "dequantize_fp32": false
                                }
                            }
                        }
                    },
                    "components": {
                        "transformer": {
                            "attention_backend": "variable:attention_backend",
                            "sparse_tau": "variable:sparse_tau",
                            "sparse_topk": "variable:sparse_topk",
                            "group_offload": {
                                "offload_type": "block_level",
                                "num_blocks_per_group": 2,
                                "use_stream": true,
                                "record_stream": true,
                                "low_cpu_mem_usage": true
                            }
                        },
                        "text_encoder": {
                            "remove_modules": [
                                "lm_head"
                            ]
                        },
                        "text_encoder.model": {
                            "truncate_layers": {
                                "language_model.layers": 51
                            },
                            "group_offload": {
                                "offload_type": "leaf_level"
                            }
                        },
                        "vae": {
                            "device": "cuda",
                            "residency": "on_demand"
                        },
                        "audio_vae": {
                            "device": "cuda",
                            "residency": "on_demand"
                        }
                    },
                    "cache": "variable:cache"
                },
                "from_pretrained_arguments": {
                    "model_name": "MiniMaxAI/MiniMax-H3",
                    "workflow": "t2va"
                },
                "loras": [
                    {
                        "model_name": "variable:lora_model_name",
                        "weight_name": "variable:lora_weight_name",
                        "adapter_name": "turbo",
                        "scale": 1.0,
                        "alpha": "variable:lora_alpha"
                    }
                ],
                "scheduler": {
                    "shift": "variable:video_shift"
                },
                "audio_scheduler": {
                    "shift": "variable:audio_shift"
                },
                "arguments": {
                    "prompt": "variable:prompt",
                    "latents": "previous_result:encode.latents",
                    "num_frames": "previous_result:encode.num_frames",
                    "width": "previous_result:encode.width",
                    "height": "previous_result:encode.height",
                    "hold_audio": "variable:source",
                    "refine_strength": "variable:refine_strength",
                    "num_inference_steps": "variable:num_inference_steps",
                    "refine_windows": {},
                    "output": [
                        "latents"
                    ]
                }
            }
        },
        {
            "name": "decode",
            "task": {
                "command": "decode_h3_latents",
                "arguments": {
                    "latents": "previous_result:refine.latents",
                    "num_frames": "previous_result:encode.source_frames"
                }
            },
            "release_models": true
        },
        {
            "name": "mux",
            "task": {
                "command": "pair_audio",
                "arguments": {
                    "video": "previous_result:decode",
                    "audio": "variable:source",
                    "fps": 24,
                    "fit": "video"
                }
            },
            "result": {
                "content_type": "video/mp4",
                "fps": 24,
                "subfolder": "final"
            }
        }
    ]
}
