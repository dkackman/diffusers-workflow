{
    "id": "MiniMaxH3Reframe",
    "description": "Reframes a keeper H3 take to a portrait or square canvas and keeps its motion, timing and soundtrack: the whole original picture stays, centred, and the border around it is generated. For a take you generated, crop it (fit_to_model mode 'crop') or re-render it natively at the new aspect first: both are cheaper and keep more detail; this is for a take whose motion must stay. 'fit' (fit_to_model, mode 'letterbox') scales 'source_video' to fit 'width' x 'height', centres it on black and returns the mask of the bars; 'align' snaps the picture's box to H3's 32 px mask cell, centre-cropping a few source pixels, so no cell straddles the box edge. 'edit' is regional-edit's masked H3 t2va edit of the letterboxed clip with that mask, at 'refine_strength' 1.0 so the bars are generated from noise rather than from black, 'mask_grow' 0 cells, and hold_audio on the original take, so its soundtrack is held. 'paste' (paste_into_box) puts the original's own pixels back inside the box, blended over a 'feather' px linear ramp inside its edges, since the kept cells came back through the VAE. 'prompt' is the take's own prompt with the new space above and below described. A 16:9 take on the default 544x960 canvas keeps a 544x320 picture, so about two thirds of the frame is generated and the picture is downscaled; 768x768 and 768x1344 work too. 768x1344 tops out near 209 frames on 24 GB, and 544x960 at 345 frames is borderline at about 23.6 GiB: validation's VRAM ceiling is an estimate there. 'num_frames' is the take's length (17n+5, 124 to 345); a longer take is cut to it.",
    "summary": "An H3 take reframed to portrait or square: picture kept, border generated.",
    "cost": [
        {
            "device": "cuda",
            "name": "RTX 3090",
            "vram_gb": 24,
            "minutes": 2.3
        }
    ],
    "cost_drivers": [
        "num_frames",
        "num_inference_steps",
        "width",
        "height",
        "weights_dtype",
        "lora_model_name",
        "attention_backend",
        "cache"
    ],
    "vram_estimate": {
        "base_gb": 16.3,
        "bytes_per_voxel": 28.71,
        "bytes_per_guide_voxel": 28.71,
        "voxel_variables": [
            "width",
            "height",
            "num_frames"
        ],
        "reason": "VAE decode's conv3d activation scales with the voxel count width * height * num_frames; base_gb and bytes_per_voxel are calibrated from two real runs: image-to-video's family baseline at 960x544x124 (on-demand VAE) succeeded at 18.03 GiB peak reserved (docs/WORKFLOW_GUIDE.md), and video-with-audio-768p at 1344x768x345 (the family's own num_frames ceiling) OOM'd mid-denoise needing >=25.82 GiB - 20.25 GiB already allocated plus a refused 5.57 GiB allocation, on a 23.56 GiB card (job 282172105da1, 2026-09-22) - closing the gap #265/#266 left the H3 family with nothing declared to check the engine's vram_estimate machinery against (#324)"
    },
    "variables": {
        "source_video": "asset:take.mp4",
        "prompt": "prompt:minimax/fox_dawn_context_ir",
        "refine_strength": 1.0,
        "mask_grow": 0,
        "align": 32,
        "feather": 16,
        "num_inference_steps": 5,
        "num_frames": 124,
        "width": 544,
        "height": 960,
        "video_shift": 6.0,
        "audio_shift": 3.0,
        "weights_dtype": "{int4}",
        "lora_scale": 1.0,
        "lora_alpha": null,
        "lora_model_name": "lightx2v/Minimax-h3-Turbo",
        "lora_weight_name": "minimax_h3_fl2v_turbo_4step_v1.2_768p_bf16.safetensors",
        "lora_adapter_name": "turbo",
        "seed": 42,
        "attention_backend": "sparse",
        "sparse_tau": 0.5,
        "sparse_topk": 0.15,
        "cache": null
    },
    "variable_constraints": {
        "num_frames": {
            "modulus": 17,
            "remainder": 5,
            "min_frames": 124,
            "max_frames": 345,
            "snap": "up",
            "reason": "the video VAE encodes 17 * n + 5 frames, and MiniMax-H3 generates between 5 and 15 seconds at 24 fps"
        },
        "width": {
            "modulus": 32,
            "remainder": 0,
            "reason": "MiniMax-H3's pipeline refuses a `width` or `height` that is not a multiple of 32, and only after the weights have loaded; refused here instead, with no 'snap', since rounding would be a silent change to the size asked for"
        },
        "height": {
            "modulus": 32,
            "remainder": 0,
            "reason": "MiniMax-H3's pipeline refuses a `width` or `height` that is not a multiple of 32, and only after the weights have loaded; refused here instead, with no 'snap', since rounding would be a silent change to the size asked for"
        }
    },
    "seed": "variable:seed",
    "steps": [
        {
            "name": "fit",
            "task": {
                "command": "fit_to_model",
                "arguments": {
                    "video": "variable:source_video",
                    "width": "variable:width",
                    "height": "variable:height",
                    "num_frames": "variable:num_frames",
                    "mode": "letterbox",
                    "align": "variable:align"
                }
            },
            "result": {
                "content_type": "video/mp4",
                "save": false
            }
        },
        {
            "name": "edit",
            "pipeline": {
                "configuration": {
                    "component_type": "ModularPipeline",
                    "pre_load_modules": [
                        "sdnq"
                    ],
                    "load_components": {
                        "dtype": "torch.bfloat16",
                        "quantization_config": {
                            "transformer": {
                                "configuration": {
                                    "config_type": "sdnq.SDNQConfig"
                                },
                                "arguments": {
                                    "weights_dtype": "variable:weights_dtype",
                                    "quantization_device": "cuda",
                                    "return_device": "cpu",
                                    "use_quantized_matmul": true,
                                    "dequantize_fp32": false,
                                    "modules_to_not_convert": [
                                        "proj_in",
                                        "audio_proj_in",
                                        "context_embedder",
                                        "time_embedder",
                                        "time_proj",
                                        "token_refiner",
                                        "norm_out",
                                        "proj_out",
                                        "audio_proj_out"
                                    ]
                                }
                            },
                            "text_encoder": {
                                "configuration": {
                                    "config_type": "sdnq.SDNQConfig"
                                },
                                "arguments": {
                                    "weights_dtype": "variable:weights_dtype",
                                    "quantization_device": "cuda",
                                    "return_device": "cpu",
                                    "dequantize_fp32": false,
                                    "modules_to_not_convert": [
                                        ".model.visual",
                                        "lm_head"
                                    ]
                                }
                            },
                            "vae": {
                                "configuration": {
                                    "config_type": "sdnq.SDNQConfig"
                                },
                                "arguments": {
                                    "weights_dtype": "{int8}",
                                    "quant_conv": true,
                                    "use_quantized_matmul_conv": true,
                                    "quantization_device": "cuda",
                                    "return_device": "cpu",
                                    "dequantize_fp32": false
                                }
                            }
                        }
                    },
                    "components": {
                        "transformer": {
                            "attention_backend": "variable:attention_backend",
                            "sparse_tau": "variable:sparse_tau",
                            "sparse_topk": "variable:sparse_topk",
                            "group_offload": {
                                "offload_type": "block_level",
                                "num_blocks_per_group": 2,
                                "use_stream": true,
                                "record_stream": true,
                                "low_cpu_mem_usage": true
                            }
                        },
                        "text_encoder": {
                            "remove_modules": [
                                "lm_head"
                            ]
                        },
                        "text_encoder.model": {
                            "truncate_layers": {
                                "language_model.layers": 51
                            },
                            "group_offload": {
                                "offload_type": "leaf_level"
                            }
                        },
                        "vae": {
                            "device": "cuda",
                            "residency": "on_demand"
                        },
                        "audio_vae": {
                            "device": "cuda",
                            "residency": "on_demand"
                        }
                    },
                    "cache": "variable:cache"
                },
                "from_pretrained_arguments": {
                    "model_name": "MiniMaxAI/MiniMax-H3",
                    "workflow": "t2va"
                },
                "loras": [
                    {
                        "model_name": "variable:lora_model_name",
                        "weight_name": "variable:lora_weight_name",
                        "adapter_name": "variable:lora_adapter_name",
                        "scale": "variable:lora_scale",
                        "alpha": "variable:lora_alpha"
                    }
                ],
                "scheduler": {
                    "shift": "variable:video_shift"
                },
                "audio_scheduler": {
                    "shift": "variable:audio_shift"
                },
                "arguments": {
                    "prompt": "variable:prompt",
                    "source_video": "previous_result:fit.video",
                    "mask_image": "previous_result:fit.mask",
                    "mask_grow": "variable:mask_grow",
                    "hold_audio": "variable:source_video",
                    "refine_strength": "variable:refine_strength",
                    "num_frames": "variable:num_frames",
                    "width": "variable:width",
                    "height": "variable:height",
                    "num_inference_steps": "variable:num_inference_steps",
                    "output": [
                        "videos",
                        "audio",
                        "sampling_rate"
                    ]
                }
            },
            "result": {
                "content_type": "video/mp4",
                "fps": 24,
                "subfolder": "intermediate"
            }
        },
        {
            "name": "paste",
            "task": {
                "command": "paste_into_box",
                "arguments": {
                    "generated": "previous_result:edit",
                    "source": "variable:source_video",
                    "content_box": "previous_result:fit.fit",
                    "feather": "variable:feather"
                }
            },
            "result": {
                "content_type": "video/mp4",
                "fps": 24,
                "subfolder": "final"
            }
        }
    ]
}
