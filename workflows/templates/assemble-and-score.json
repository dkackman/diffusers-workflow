{
    "id": "assemble-and-score",
    "description": "Cuts shots that already exist into one film with a score under them, generating nothing in the run. It is the pass you re-run while cutting, when re-generating the footage each time would cost GPU hours to change a fade. The shots go straight into concat_videos as hard cuts - nothing is stabilized or rescaled on the way, so a deliberate camera move survives the edit; they must already share one size and frame rate, and the task refuses a set that does not. 'shots' is a list, so a diptych is two entries and a reel is however many the cut needs. The shots' own recorded sound is carried up to the score's sample rate and mixed underneath it, so the room tone of each world survives the edit instead of being replaced by music. Supply the shots and the score as asset: references - 'shot_1.mp4' and friends, uploaded with upload_asset or promoted from a generated run with keep_output.",
    "cost": [
        {"device": "cuda", "name": "RTX 3090", "vram_gb": 24, "minutes": 0.2}
    ],
    "variables": {
        "shots": [
            "asset:shot_1.mp4",
            "asset:shot_2.mp4",
            "asset:shot_3.mp4"
        ],
        "score": "asset:score.wav",
        "sample_rate": 44100,
        "fps": 24,
        "audio_bleed_ms": 0,
        "seam_fade_ms": null,
        "score_start_frame": 0,
        "total_frames": 360,
        "score_gain": 1.0,
        "world_gain": 1.8
    },
    "steps": [
        {
            "name": "edit",
            "task": {
                "command": "concat_videos",
                "arguments": {
                    "videos": "variable:shots",
                    "fps": "variable:fps",
                    "audio_bleed_ms": "variable:audio_bleed_ms",
                    "seam_fade_ms": "variable:seam_fade_ms"
                }
            }
        },
        {
            "name": "world",
            "task": {
                "command": "resample_audio",
                "arguments": {
                    "audio": "previous_result:edit",
                    "target_sample_rate": "variable:sample_rate"
                }
            }
        },
        {
            "name": "soundtrack",
            "task": {
                "command": "slice_audio",
                "arguments": {
                    "audio": "variable:score",
                    "start_frame": "variable:score_start_frame",
                    "num_frames": "variable:total_frames",
                    "fps": "variable:fps",
                    "sample_rate": "variable:sample_rate"
                }
            }
        },
        {
            "name": "mixed",
            "task": {
                "command": "mix_audio",
                "arguments": {
                    "audios": [
                        "previous_result:soundtrack",
                        "previous_result:world"
                    ],
                    "gains": [
                        "variable:score_gain",
                        "variable:world_gain"
                    ],
                    "sample_rate": "variable:sample_rate"
                }
            }
        },
        {
            "name": "balanced",
            "task": {
                "command": "normalize_audio",
                "arguments": {
                    "audio": "previous_result:mixed",
                    "peak_dbfs": -1.0,
                    "sample_rate": "variable:sample_rate"
                }
            }
        },
        {
            "name": "film",
            "task": {
                "command": "pair_audio",
                "arguments": {
                    "video": "previous_result:edit",
                    "audio": "previous_result:balanced",
                    "sample_rate": "variable:sample_rate"
                }
            },
            "result": {
                "content_type": "video/mp4",
                "fps": 24
            }
        }
    ]
}
