{
    "variables": {
        "prompt": "recolor this person's hair blonde",
        "input_image": {
            "location": "https://pbs.twimg.com/media/HNi-N_eWIAAJfTZ?format=jpg&name=900x900"
        }
    },
    "id": "Krea2Edit",
    "steps": [
        {
            "name": "txt2img",
            "pipeline": {
                "configuration": {
                    "component_type": "Krea2Pipeline",
                    "offload": "sequential"
                },
                "from_pretrained_arguments": {
                    "model_name": "krea/Krea-2-Turbo",
                    "torch_dtype": "torch.bfloat16",
                    "custom_pipeline": "ostris/Krea2OstrisEdit",
                    "trust_remote_code": true
                },
                "loras": [
                    {
                        "model_name": "conradlocke/krea2-identity-edit",
                        "weight_name": "krea2_identity_edit_v1_2.safetensors"
                    }
                ],
                "arguments": {
                    "prompt": "variable:prompt",
                    "image": "variable:input_image",
                    "num_inference_steps": 8,
                    "guidance_scale": 0.0
                }
            },
            "result": {
                "content_type": "image/jpeg",
                "embed_metadata": true
            }
        }
    ]
}